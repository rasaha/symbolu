# RM1 RunPod environment — copy to a NON-COMMITTED file and edit.
#
#   cp scripts/runpod_rm1/env.example scripts/runpod_rm1/env.local
#   $EDITOR scripts/runpod_rm1/env.local
#
# scripts/runpod_rm1/common.sh auto-sources scripts/runpod_rm1/env.local (or the
# file named in $RUNPOD_ENV_FILE). env.local is git-ignored. NEVER commit a real token.

# ---- repository ----
export UGENCE_REPO_URL="<repository-url>"                 # e.g. https://github.com/rasaha/symbolu.git
# export UGENCE_REPO_DIR="/workspace/ugence"              # default
# export UGENCE_BRANCH="claude/rm1-real-model-validation-yfn2gx"   # default

# ---- model (REQUIRED — no fake default is provided) ----
export UGENCE_REAL_MODEL_ID="<hugging-face-model-id>"     # e.g. mistralai/Mistral-7B-Instruct-v0.3
export UGENCE_MODEL_REVISION="<exact-model-revision>"     # recommended (pin a commit sha); may be left unset

# ---- Hugging Face auth (only if the model is gated). NEVER commit a real token. ----
export HF_TOKEN="<token-if-required>"

# ---- run configuration ----
export RM1_DEVICE="cuda"
export RM1_DTYPE="auto"                # auto|bf16|fp16|fp32
export RM1_LOAD_IN_4BIT=0             # set to 1 ONLY for explicit 4-bit CUDA execution
export RM1_MAX_INPUT_TOKENS=4096
export RM1_MAX_NEW_TOKENS=512

# ---- optional knobs (defaults shown) ----
# export RM1_OUTPUT_ROOT="/workspace/ugence_rm1"
# export RM1_SMOKE_LIMIT=10
# export RM1_FULL_LIMIT=              # empty => full held-out set
# export RM1_SEED=101
# export RM1_SECOND_SEED=202
# export RM1_CLARIFICATION_LIMIT=1
