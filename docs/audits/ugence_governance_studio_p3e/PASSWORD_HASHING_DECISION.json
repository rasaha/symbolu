{
  "decision": "argon2id",
  "rationale": "argon2-cffi installs reproducibly from the allowlisted PyPI (correcting the earlier offline-unavailability conclusion); Argon2id is the preferred KDF.",
  "library": "argon2-cffi",
  "algorithm": "Argon2id",
  "record_format": "$argon2id$v=19$m=<KiB>,t=<iters>,p=<lanes>$<salt_b64>$<hash_b64>",
  "parameters": {"time_cost": 3, "memory_cost_kib": 65536, "parallelism": 4, "hash_len": 32, "salt_len": 16},
  "maximum_accepted": {"memory_cost_kib": 262144, "time_cost": 10, "parallelism": 8},
  "salt": "library-managed random",
  "verification": "library constant-time verify",
  "excessive_cost_rejected_before_kdf": true,
  "malformed_hash": "fails closed (rejected)",
  "unsupported_version": "fails closed (only $argon2id$ and legacy scrypt$ accepted)",
  "legacy_scrypt": "verify-only for migration; never generated",
  "cli_prints_password": false,
  "plaintext_password_env_in_production": false,
  "in_sbom_and_audit": true,
  "tests": "deployment/governance-studio/tests/test_passwords.py"
}
