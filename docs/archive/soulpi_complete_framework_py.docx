**Part 2: The Complete Soulpi Mapping Engine**

#!/usr/bin/env python3

\"\"\"

Soulpi Complete Mapping Engine

Inner → Kosha \| Outer → Ontological Layer

\"\"\"

import numpy as np

from typing import Dict, List, Tuple

from dataclasses import dataclass

\@dataclass

class DualLayerMapping:

\"\"\"Complete dual-layer mapping for a word.\"\"\"

word: str

\# Inner layer

inner_acoustic_truth: str

dominant_kosha: str

kosha_distribution: Dict\[str, float\]

inner_qualities: List\[str\]

\# Outer layer

outer_cultural_meaning: str

dominant_ontology: str

ontology_distribution: Dict\[str, float\]

outer_qualities: List\[str\]

\# Integration

inner_outer_tension: float

life_pattern_prediction: str

class SoulpiCompleteMappingEngine:

\"\"\"

Complete Soulpi engine with dual-layer mapping:

\- Inner (acoustic) → Kosha layers

\- Outer (cultural) → Ontological layers

\"\"\"

def \_\_init\_\_(self):

self.kosha_layers = KOSHA_LAYERS

self.ontological_layers = ONTOLOGICAL_LAYERS

\# Consonant → Kosha mapping (inner/acoustic)

self.consonant_to_kosha = self.\_initialize_consonant_kosha_map()

\# Semantic → Ontology mapping (outer/cultural)

self.semantic_to_ontology = self.\_initialize_semantic_ontology_map()

def \_initialize_consonant_kosha_map(self) -\> Dict:

\"\"\"

Map consonants to Koshas based on acoustic qualities.

Principle: Consonant acoustic signature reveals inner layer.

\"\"\"

return {

\# ANNAMAYA (Physical/Dense)

\'M\': \'Annamaya\', \# Heavy, closed, matter-like

\'B\': \'Annamaya\', \# Bursting, body-like

\'G\': \'Annamaya\', \# Gravitational, grounded

\'D\': \'Annamaya\', \# Definitive, solid

\# PRANAMAYA (Energetic/Flow)

\'R\': \'Pranamaya\', \# Rolling, restless energy

\'V\': \'Pranamaya\', \# Vibrating, vital

\'W\': \'Pranamaya\', \# Wavering, energy flow

\'Y\': \'Pranamaya\', \# Yearning, energy reaching

\'L\': \'Pranamaya\', \# Liquid, flowing

\# MANOMAYA (Mental/Emotional)

\'S\': \'Manomaya\', \# Scattering thoughts

\'H\': \'Manomaya\', \# Breath of mind

\'F\': \'Manomaya\', \# Friction, worry

\'Z\': \'Manomaya\', \# Buzzing, mental agitation

\'N\': \'Manomaya\', \# Nasal, internalized emotion

\# VIJNANAMAYA (Wisdom/Discernment)

\'K\': \'Vijnanamaya\', \# Cutting discernment

\'T\': \'Vijnanamaya\', \# Separating truth

\'Sh\': \'Vijnanamaya\', \# Sharp penetration

\'Ch\': \'Vijnanamaya\', \# Choosing, discriminating

\'P\': \'Vijnanamaya\', \# Precision, pointing

\# ANANDAMAYA (Bliss/Being)

\# (Minimal consonants, mostly vowels reach this)

\# Only extremely soft or aspirated sounds

}

def \_initialize_semantic_ontology_map(self) -\> Dict:

\"\"\"

Map semantic domains to ontological layers.

Principle: Word\'s cultural meaning reveals outer layer.

\"\"\"

return {

\# Keywords → Ontological layer mapping

\'body\': \'Body\',

\'physical\': \'Body\',

\'material\': \'Body\',

\'form\': \'Body\',

\'flesh\': \'Body\',

\'think\': \'Thinking\',

\'reason\': \'Thinking\',

\'logic\': \'Thinking\',

\'analyze\': \'Thinking\',

\'concept\': \'Thinking\',

\'mind\': \'Thinking\',

\'feel\': \'Feeling\',

\'emotion\': \'Feeling\',

\'heart\': \'Feeling\',

\'sentiment\': \'Feeling\',

\'mood\': \'Feeling\',

\'purpose\': \'Purposing\',

\'goal\': \'Purposing\',

\'aim\': \'Purposing\',

\'intention\': \'Purposing\',

\'direction\': \'Purposing\',

\'meaning\': \'Purposing\',

\'word\': \'Language\',

\'speak\': \'Language\',

\'say\': \'Language\',

\'communicate\': \'Language\',

\'express\': \'Language\',

\'language\': \'Language\',

\'relate\': \'Relating\',

\'relationship\': \'Relating\',

\'connect\': \'Relating\',

\'bond\': \'Relating\',

\'together\': \'Relating\',

\'friend\': \'Relating\',

\'love\': \'Relating\',

\'society\': \'Society\',

\'culture\': \'Society\',

\'collective\': \'Society\',

\'community\': \'Society\',

\'social\': \'Society\',

\'people\': \'Society\',

\'environment\': \'Environment\',

\'world\': \'Environment\',

\'nature\': \'Environment\',

\'earth\': \'Environment\',

\'ecology\': \'Environment\',

\'universe\': \'Universe\',

\'cosmos\': \'Universe\',

\'infinite\': \'Universe\',

\'eternal\': \'Universe\',

\'cosmic\': \'Universe\',

\'totality\': \'Totality\',

\'absolute\': \'Totality\',

\'all\': \'Totality\',

\'everything\': \'Totality\',

\'whole\': \'Totality\',

\'complete\': \'Totality\'

}

def map_word_complete(self, word: str, 

cultural_meaning: str = None) -\> DualLayerMapping:

\"\"\"

Complete dual-layer mapping of a word.

Args:

word: The word to analyze

cultural_meaning: Optional cultural/dictionary meaning

Returns:

Complete dual-layer mapping

\"\"\"

\# INNER LAYER: Acoustic → Kosha

inner_result = self.\_map_inner_to_kosha(word)

\# OUTER LAYER: Cultural → Ontology

outer_result = self.\_map_outer_to_ontology(word, cultural_meaning)

\# INTEGRATION: Compute tension

tension = self.\_compute_inner_outer_tension(

inner_result\[\'dominant_kosha\'\],

outer_result\[\'dominant_ontology\'\]

)

\# PREDICTION: Life pattern from tension

prediction = self.\_predict_life_pattern(

inner_result, outer_result, tension

)

return DualLayerMapping(

word=word,

inner_acoustic_truth=inner_result\[\'acoustic_truth\'\],

dominant_kosha=inner_result\[\'dominant_kosha\'\],

kosha_distribution=inner_result\[\'kosha_distribution\'\],

inner_qualities=inner_result\[\'qualities\'\],

outer_cultural_meaning=outer_result\[\'cultural_meaning\'\],

dominant_ontology=outer_result\[\'dominant_ontology\'\],

ontology_distribution=outer_result\[\'ontology_distribution\'\],

outer_qualities=outer_result\[\'qualities\'\],

inner_outer_tension=tension,

life_pattern_prediction=prediction

)

def \_map_inner_to_kosha(self, word: str) -\> Dict:

\"\"\"

Map word\'s inner (acoustic) layer to Koshas.

Process:

1\. Extract consonants

2\. Map each consonant to Kosha

3\. Aggregate to distribution

4\. Derive acoustic truth

\"\"\"

word_lower = word.lower()

\# Extract consonants

vowels = set(\'aāiīuūeēoōaiauṛṝḷḹ\')

consonants = \[c for c in word_lower if c not in vowels and
c.isalpha()\]

\# Map to Koshas

kosha_counts = {

\'Annamaya\': 0,

\'Pranamaya\': 0,

\'Manomaya\': 0,

\'Vijnanamaya\': 0,

\'Anandamaya\': 0

}

for consonant in consonants:

c_upper = consonant.upper()

if c_upper in self.consonant_to_kosha:

kosha = self.consonant_to_kosha\[c_upper\]

kosha_counts\[kosha\] += 1

\# If no consonants (pure vowels), map to Anandamaya

if sum(kosha_counts.values()) == 0:

kosha_counts\[\'Anandamaya\'\] = 1

\# Normalize to distribution

total = sum(kosha_counts.values())

kosha_distribution = {

k: v/total for k, v in kosha_counts.items()

}

\# Dominant Kosha

dominant_kosha = max(kosha_distribution, key=kosha_distribution.get)

\# Derive acoustic truth

acoustic_truth = self.\_derive_acoustic_truth(consonants,
dominant_kosha)

\# Extract qualities

qualities = self.kosha_layers\[dominant_kosha\]\[\'inner_qualities\'\]

return {

\'acoustic_truth\': acoustic_truth,

\'dominant_kosha\': dominant_kosha,

\'kosha_distribution\': kosha_distribution,

\'qualities\': qualities

}

def \_map_outer_to_ontology(self, word: str, cultural_meaning: str =
None) -\> Dict:

\"\"\"

Map word\'s outer (cultural) layer to Ontological layers.

Process:

1\. Get cultural/dictionary meaning

2\. Extract semantic keywords

3\. Map to ontological layers

4\. Aggregate to distribution

\"\"\"

word_lower = word.lower()

\# If cultural meaning provided, use it

if cultural_meaning:

meaning_text = cultural_meaning.lower()

else:

\# Use word itself as proxy (would connect to dictionary API)

meaning_text = word_lower

\# Map semantic keywords to ontology

ontology_counts = {layer: 0 for layer in ONTOLOGICAL_LAYERS.keys()}

\# Check each keyword in semantic map

for keyword, ontology in self.semantic_to_ontology.items():

if keyword in meaning_text or keyword in word_lower:

ontology_counts\[ontology\] += 1

\# If no matches, default based on word structure

if sum(ontology_counts.values()) == 0:

\# Default heuristic: word length suggests ontological depth

if len(word) \<= 4:

ontology_counts\[\'Body\'\] = 1 \# Short = concrete

elif len(word) \<= 7:

ontology_counts\[\'Thinking\'\] = 1 \# Medium = mental

else:

ontology_counts\[\'Universe\'\] = 1 \# Long = abstract

\# Normalize to distribution

total = sum(ontology_counts.values())

ontology_distribution = {

k: v/total for k, v in ontology_counts.items()

}

\# Dominant ontology

dominant_ontology = max(ontology_distribution,
key=ontology_distribution.get)

\# Cultural meaning

if cultural_meaning:

cultural = cultural_meaning

else:

cultural = f\"\[{dominant_ontology} domain\]: {word}\"

\# Extract qualities

qualities =
self.ontological_layers\[dominant_ontology\]\[\'outer_qualities\'\]

return {

\'cultural_meaning\': cultural,

\'dominant_ontology\': dominant_ontology,

\'ontology_distribution\': ontology_distribution,

\'qualities\': qualities

}

def \_derive_acoustic_truth(self, consonants: List\[str\],
dominant_kosha: str) -\> str:

\"\"\"Derive acoustic truth from consonant pattern.\"\"\"

if not consonants:

return \"Pure vibration, transcendent stillness\"

\# Build acoustic signature

consonant_str = \'\'.join(\[c.upper() for c in consonants\])

kosha_signatures = {

\'Annamaya\': f\"Dense, material vibration: {consonant_str}\",

\'Pranamaya\': f\"Restless, energetic flow: {consonant_str}\",

\'Manomaya\': f\"Mental agitation, emotional turbulence:
{consonant_str}\",

\'Vijnanamaya\': f\"Penetrating discrimination, sharp insight:
{consonant_str}\",

\'Anandamaya\': f\"Subtle resonance, dissolving form: {consonant_str}\"

}

return kosha_signatures.get(dominant_kosha, consonant_str)

def \_compute_inner_outer_tension(self, kosha: str, ontology: str) -\>
float:

\"\"\"

Compute tension between inner (Kosha) and outer (Ontology).

Logic:

\- Deep Kosha (Anandamaya) + Surface Ontology (Body) = HIGH tension

\- Matching levels (both deep or both surface) = LOW tension

\"\"\"

kosha_depth = {

\'Annamaya\': 1,

\'Pranamaya\': 2,

\'Manomaya\': 3,

\'Vijnanamaya\': 4,

\'Anandamaya\': 5

}

ontology_abstraction = {

\'Body\': 1,

\'Thinking\': 2,

\'Feeling\': 3,

\'Purposing\': 4,

\'Language\': 5,

\'Relating\': 6,

\'Society\': 7,

\'Environment\': 8,

\'Universe\': 9,

\'Totality\': 10

}

kosha_level = kosha_depth.get(kosha, 3)

ontology_level = ontology_abstraction.get(ontology, 5)

\# Normalize ontology to 1-5 scale

ontology_normalized = (ontology_level / 10) \* 5

\# Tension = absolute difference

tension = abs(kosha_level - ontology_normalized) / 5.0

return tension

def \_predict_life_pattern(self, inner: Dict, outer: Dict, tension:
float) -\> str:

\"\"\"Predict life pattern from inner-outer dynamics.\"\"\"

kosha = inner\[\'dominant_kosha\'\]

ontology = outer\[\'dominant_ontology\'\]

if tension \> 0.6:

return (

f\"HIGH TENSION: Inner {kosha} consciousness conflicts with \"

f\"outer {ontology} expression. Life pattern: constant effort to \"

f\"reconcile deep inner truth with surface social role. Likely
experiences \"

f\"of inauthenticity, restless seeking, or spiritual crisis.\"

)

elif tension \> 0.3:

return (

f\"MODERATE TENSION: Inner {kosha} and outer {ontology} create \"

f\"productive friction. Life pattern: creative tension drives growth, \"

f\"gradual integration of inner wisdom with outer manifestation.\"

)

else:

return (

f\"LOW TENSION: Inner {kosha} aligns with outer {ontology}. \"

f\"Life pattern: authentic expression, natural integration, \"

f\"congruence between inner experience and outer role.\"

)

def visualize_complete_mapping(self, word: str, cultural_meaning: str =
None) -\> str:

\"\"\"Create comprehensive visualization.\"\"\"

mapping = self.map_word_complete(word, cultural_meaning)

viz = f\"\\n{\'=\'\*70}\\n\"

viz += f\"SOULPI COMPLETE DUAL-LAYER MAPPING: \'{word.upper()}\'\\n\"

viz += f\"{\'=\'\*70}\\n\\n\"

\# INNER LAYER

viz += f\"INNER LAYER (Acoustic → Kosha):\\n\"

viz += f\"─────────────────────────────────────\\n\"

viz += f\" Acoustic Truth: {mapping.inner_acoustic_truth}\\n\"

viz += f\" Dominant Kosha: {mapping.dominant_kosha}\\n\"

viz += f\" Kosha Distribution:\\n\"

for kosha, prob in mapping.kosha_distribution.items():

if prob \> 0:

bar = \'█\' \* int(prob \* 20)

viz += f\" {kosha:15s} {prob:.2f} {bar}\\n\"

viz += f\" Inner Qualities:\\n\"

for qual in mapping.inner_qualities\[:3\]:

viz += f\" • {qual}\\n\"

viz += \"\\n\"

\# OUTER LAYER

viz += f\"OUTER LAYER (Cultural → Ontology):\\n\"

viz += f\"─────────────────────────────────────\\n\"

viz += f\" Cultural Meaning: {mapping.outer_cultural_meaning}\\n\"

viz += f\" Dominant Ontology: {mapping.dominant_ontology}\\n\"

viz += f\" Ontology Distribution:\\n\"

for onto, prob in mapping.ontology_distribution.items():

if prob \> 0:

bar = \'▓\' \* int(prob \* 20)

viz += f\" {onto:15s} {prob:.2f} {bar}\\n\"

viz += f\" Outer Qualities:\\n\"

for qual in mapping.outer_qualities\[:3\]:

viz += f\" • {qual}\\n\"

viz += \"\\n\"

\# INTEGRATION

viz += f\"INNER-OUTER INTEGRATION:\\n\"

viz += f\"─────────────────────────────────────\\n\"

viz += f\" Tension Level: {mapping.inner_outer_tension:.2f} \"

viz += f\"({\'High\' if mapping.inner_outer_tension \> 0.6 else
\'Moderate\' if mapping.inner_outer_tension \> 0.3 else \'Low\'})\\n\"

viz += f\" Life Pattern:\\n\"

for line in mapping.life_pattern_prediction.split(\'. \'):

if line:

viz += f\" {line.strip()}.\\n\"

viz += f\"\\n{\'=\'\*70}\\n\"

return viz

