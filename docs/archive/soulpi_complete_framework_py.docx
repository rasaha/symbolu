\# ============================================================

\# SYMBOL-U INTEGRATION WITH COMPLETE MAPPING

\# ============================================================

class SymbolUCompleteIntegration:

\"\"\"

Integrate complete dual-layer mapping into Symbol-U.

Process:

1\. Input text → words

2\. Each word → Inner (Kosha) + Outer (Ontology)

3\. Kosha distribution → influences Vritti

4\. Ontology distribution → influences Aspect activation

5\. Blend for final Symbol-U state

\"\"\"

def \_\_init\_\_(self):

self.soulpi = SoulpiCompleteMappingEngine()

def enhanced_symbol_u_inference(self, input_text: str) -\> Dict:

\"\"\"

Symbol-U inference enhanced with complete Soulpi mapping.

\"\"\"

import numpy as np

words = input_text.split()

\# Analyze each word

mappings = \[

self.soulpi.map_word_complete(word)

for word in words

\]

\# Aggregate Kosha distributions (inner)

kosha_dists = \[m.kosha_distribution for m in mappings\]

avg_kosha_dist = self.\_average_distributions(kosha_dists)

\# Aggregate Ontology distributions (outer)

ontology_dists = \[m.ontology_distribution for m in mappings\]

avg_ontology_dist = self.\_average_distributions(ontology_dists)

\# Map Kosha → Vritti (inner influences mental states)

P_vritti_inner = self.\_kosha_to_vritti(avg_kosha_dist)

\# Map Ontology → Aspect (outer influences dimensional activation)

P_aspect_outer = self.\_ontology_to_aspect(avg_ontology_dist)

\# Compute average tension

avg_tension = np.mean(\[m.inner_outer_tension for m in mappings\])

return {

\'input_text\': input_text,

\'word_mappings\': mappings,

\'kosha_distribution\': avg_kosha_dist,

\'ontology_distribution\': avg_ontology_dist,

\'P_vritti_inner\': P_vritti_inner,

\'P_aspect_outer\': P_aspect_outer,

\'average_tension\': avg_tension,

\'interpretation\': self.\_interpret_complete_mapping(

avg_kosha_dist, avg_ontology_dist, avg_tension

)

}

def \_average_distributions(self, dist_list: List\[Dict\]) -\> Dict:

\"\"\"Average multiple distributions.\"\"\"

if not dist_list:

return {}

keys = dist_list\[0\].keys()

avg_dist = {}

for key in keys:

avg_dist\[key\] = np.mean(\[d.get(key, 0) for d in dist_list\])

return avg_dist

def \_kosha_to_vritti(self, kosha_dist: Dict) -\> np.ndarray:

\"\"\"

Map Kosha distribution to Vritti distribution.

Logic:

\- Annamaya → Nidrā (inertness, body-bound)

\- Pranamaya → Vikalpa (restless energy = imagination)

\- Manomaya → Viparyaya (emotional turbulence = misperception)

\- Vijnanamaya → Pramāṇa (wisdom = valid cognition)

\- Anandamaya → Pramāṇa (bliss = clear seeing)

\"\"\"

kosha_to_vritti_map = {

\'Annamaya\': \[0.1, 0.1, 0.2, 0.6, 0.0\], \# → Nidrā dominant

\'Pranamaya\': \[0.1, 0.7, 0.1, 0.05, 0.05\], \# → Vikalpa dominant

\'Manomaya\': \[0.1, 0.3, 0.5, 0.05, 0.05\], \# → Viparyaya dominant

\'Vijnanamaya\': \[0.7, 0.1, 0.05, 0.05, 0.1\],# → Pramāṇa dominant

\'Anandamaya\': \[0.8, 0.05, 0.05, 0.05, 0.05\]# → Pramāṇa dominant

}

P_vritti = np.zeros(5)

for kosha, weight in kosha_dist.items():

if kosha in kosha_to_vritti_map:

P_vritti += weight \* np.array(kosha_to_vritti_map\[kosha\])

\# Normalize

return P_vritti / P_vritti.sum() if P_vritti.sum() \> 0 else np.ones(5)
/ 5

def \_ontology_to_aspect(self, ontology_dist: Dict) -\> np.ndarray:

\"\"\"

Map Ontology distribution to Aspect distribution.

Direct mapping (1-to-1 for first 10 aspects).

\"\"\"

aspect_order = \[

\'Body\', \'Thinking\', \'Feeling\', \'Purposing\', \'Language\',

\'Relating\', \'Society\', \'Environment\', \'Universe\', \'Totality\'

\]

P_aspect = np.zeros(10)

for i, aspect in enumerate(aspect_order):

P_aspect\[i\] = ontology_dist.get(aspect, 0)

\# Normalize

return P_aspect / P_aspect.sum() if P_aspect.sum() \> 0 else np.ones(10)
/ 10

def \_interpret_complete_mapping(self, kosha_dist: Dict, 

ontology_dist: Dict, 

tension: float) -\> str:

\"\"\"Interpret the complete mapping.\"\"\"

dominant_kosha = max(kosha_dist, key=kosha_dist.get)

dominant_ontology = max(ontology_dist, key=ontology_dist.get)

interp = f\"COMPLETE SOULPI INTERPRETATION:\\n\\n\"

interp += f\"Inner (Acoustic) Truth:\\n\"

interp += f\" • Dominant Kosha: {dominant_kosha}\\n\"

interp += f\" • This reveals deep {dominant_kosha} consciousness as
primary driver\\n\\n\"

interp += f\"Outer (Cultural) Expression:\\n\"

interp += f\" • Dominant Ontology: {dominant_ontology}\\n\"

interp += f\" • This shows {dominant_ontology} as primary social
manifestation\\n\\n\"

interp += f\"Tension Level: {tension:.2f}\\n\"

if tension \> 0.6:

interp += f\" • HIGH tension suggests significant inner-outer
conflict\\n\"

interp += f\" • Life pattern: Restless seeking to align depth with
surface\\n\"

elif tension \> 0.3:

interp += f\" • MODERATE tension creates productive creative
friction\\n\"

interp += f\" • Life pattern: Growth through integration challenges\\n\"

else:

interp += f\" • LOW tension indicates authentic alignment\\n\"

interp += f\" • Life pattern: Natural congruence, integrated
expression\\n\"

return interp

