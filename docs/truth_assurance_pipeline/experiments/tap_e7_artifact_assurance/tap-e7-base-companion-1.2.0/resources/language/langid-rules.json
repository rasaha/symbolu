{"boundaries":{"english_at_or_above":0.6,"non_english_at_or_below":0.2},"denominator":"count of residual content tokens after L1","english_suffix":["ing","ed","ly","tion","ment","ness","s","es"],"input":"assertive_span_tokens","min_residual":1,"no_score_exposed":true,"output":"ENGLISH|NON_ENGLISH|UNRESOLVED","resource_id":"BASE-LANGID","rules":[{"classes":["URL","NUMBER","SYMBOL","PROPER_NOUN_SHAPE","ACRONYM_ALLCAPS","TECH_IDENT"],"op":"strip","rule_id":"L1"},{"op":"residual_content_tokens","rule_id":"L2"},{"if":"residual==0","result":"UNRESOLVED","rule_id":"L3"},{"measure":"frac_english = |residual ∩ ENG-CORE ∪ english_suffix| / |residual|","rule_id":"L4"},{"if":"frac_english>=0.60","result":"ENGLISH","rule_id":"L5"},{"if":"frac_english<=0.20","result":"NON_ENGLISH","rule_id":"L6"},{"else":"UNRESOLVED","rule_id":"L7"}],"version":"1.0"}
