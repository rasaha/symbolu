**PART III: CORE IMPLEMENTATION FUNCTIONS**

**3.1 Function 1: Syllable → Kosha**

def get_kosha_from_syllable(syllable: str) -\> dict:

\"\"\"

Maps a syllable to its Kosha layer based on consonant.

Args:

syllable: Single syllable (e.g., \"ra\", \"ke\", \"sha\")

Returns:

{

\'syllable\': str,

\'consonant\': str,

\'kosha_id\': int (1-5),

\'kosha_name\': str,

\'vritti\': str,

\'qualities\': list,

\'explanation\': str

}

\"\"\"

syll = syllable.lower()

\# Check for 2-character consonant clusters first

if syll.startswith(\"kṣa\") or syll.startswith(\"ksh\"):

return {

\'syllable\': syllable,

\'consonant\': \'kṣa\',

\'kosha_id\': 4,

\'kosha_name\': \'VIJNANAMAYA\',

\'vritti\': \'Pramāṇa\',

\'qualities\': \[\'Ultimate discrimination\', \'Complete cutting\'\],

\'explanation\': \'Sharp discriminative wisdom\'

}

if syll.startswith(\"cha\"):

return {

\'syllable\': syllable,

\'consonant\': \'cha\',

\'kosha_id\': 2,

\'kosha_name\': \'PRANAMAYA\',

\'vritti\': \'Vikalpa\',

\'qualities\': \[\'Scattered energy\', \'Aspirated projection\'\],

\'explanation\': \'Pranic turbulence, energetic agitation\'

}

\# Check single consonants

for ch in syll:

if ch in CONSONANT_TO_KOSHA_MAP:

kosha_id = CONSONANT_TO_KOSHA_MAP\[ch\]

kosha_name = KOSHA_ID_TO_NAME\[kosha_id\]

return {

\'syllable\': syllable,

\'consonant\': ch,

\'kosha_id\': kosha_id,

\'kosha_name\': kosha_name,

\'vritti\': KOSHA_VRITTI_MAP\[kosha_name\],

\'qualities\': KOSHA_QUALITIES\[kosha_name\]\[\'qualities\'\],

\'explanation\': KOSHA_QUALITIES\[kosha_name\]\[\'acoustic\'\]

}

\# If vowel-only syllable → Anandamaya

return {

\'syllable\': syllable,

\'consonant\': None,

\'kosha_id\': 5,

\'kosha_name\': \'ANANDAMAYA\',

\'vritti\': \'Pramāṇa\',

\'qualities\': \[\'Pure vibration\', \'No obstruction\'\],

\'explanation\': \'Vowel-only syllable reaches bliss layer\'

}

**3.2 Function 2: Word → Ontology**

def get_ontology_from_word(word: str) -\> dict:

\"\"\"

Maps a word to its Ontological layer based on semantic meaning.

Args:

word: Single word

Returns:

{

\'word\': str,

\'ontology_id\': int (1-10),

\'ontology_name\': str,

\'confidence\': float,

\'explanation\': str

}

\"\"\"

\# Seed semantic mapping (expand with ML classifier)

SEMANTIC_ONTOLOGY_MAP = {

\# Execution (1)

\"walk\": 1, \"run\": 1, \"move\": 1, \"act\": 1, \"do\": 1,

\# Identity (2)

\"name\": 2, \"identity\": 2, \"label\": 2, \"tag\": 2, \"self\": 2,

\# Form (3)

\"body\": 3, \"shape\": 3, \"form\": 3, \"physical\": 3, \"matter\": 3,

\# Cognition (4)

\"think\": 4, \"thought\": 4, \"cognition\": 4, \"mind\": 4,
\"perceive\": 4,

\# Agency (5)

\"control\": 5, \"will\": 5, \"ego\": 5, \"power\": 5, \"agency\": 5,

\# Reasoning (6)

\"reason\": 6, \"logic\": 6, \"analyze\": 6, \"intellect\": 6,

\# Purpose (7)

\"purpose\": 7, \"meaning\": 7, \"dharma\": 7, \"mission\": 7, \"love\":
7,

\# Observation (8)

\"witness\": 8, \"observe\": 8, \"awareness\": 8, \"truth\": 8,
\"watch\": 8,

\# Core (9)

\"soul\": 9, \"essence\": 9, \"core\": 9, \"atman\": 9, \"being\": 9,

\# Universal (10)

\"god\": 10, \"universe\": 10, \"brahman\": 10, \"cosmic\": 10, \"all\":
10,

\"rakesh\": 10 \# Example: lord of moon → universal

}

w = word.lower()

if w in SEMANTIC_ONTOLOGY_MAP:

onto_id = SEMANTIC_ONTOLOGY_MAP\[w\]

confidence = 0.95

else:

\# Fallback: REASONING layer

onto_id = 6

confidence = 0.50

onto_name = ONTO_ID_TO_NAME\[onto_id\]

return {

\'word\': word,

\'ontology_id\': onto_id,

\'ontology_name\': onto_name,

\'confidence\': confidence,

\'explanation\': f\"Semantic meaning maps to {onto_name} domain\"

}

**3.3 Function 3: SMI (Soulpi Mismatch Index)**

def compute_smi(inner_kosha: int, 

outer_ontology: int,

HD: float = 0.0, \# Dimensional entropy

HG: float = 0.0, \# Guna entropy

HK: float = 0.0, \# Kosha entropy

domain_jumps: int = 0,

tone_shift: float = 0.0,

w1: float = 1.0,

w2: float = 0.5,

w3: float = 0.3) -\> dict:

\"\"\"

Computes Soulpi Mismatch Index (SMI).

SMI = w1 \* base_gap + w2 \* entropy + w3 \* stability

Args:

inner_kosha: Kosha level (1-5)

outer_ontology: Ontology level (1-10)

HD, HG, HK: Entropy components

domain_jumps: Number of ontology domain switches

tone_shift: Emotional tone shift magnitude

w1, w2, w3: Weight coefficients

Returns:

{

\'inner_kosha\': int,

\'outer_ontology\': int,

\'base_gap\': float,

\'entropy_component\': float,

\'stability_component\': float,

\'SMI\': float,

\'interpretation\': str

}

\"\"\"

\# Normalize kosha to 0-1 scale (same as ontology)

inner_normalized = inner_kosha / 5.0

outer_normalized = outer_ontology / 10.0

\# Base gap component

base_gap = abs(inner_normalized - outer_normalized)

\# Entropy component (average of three entropies)

entropy_component = (HD + HG + HK) / 3.0

\# Stability component

stability_component = 0.1 \* domain_jumps + 0.1 \* tone_shift

\# Total SMI

SMI = (w1 \* base_gap) + (w2 \* entropy_component) + (w3 \*
stability_component)

\# Interpretation

if SMI \> 0.6:

interpretation = \"HIGH MISMATCH: Strong inner-outer conflict. Likely
emotional masking or unconscious dissonance.\"

elif SMI \> 0.4:

interpretation = \"MODERATE MISMATCH: Noticeable tension between inner
truth and outer expression.\"

elif SMI \> 0.2:

interpretation = \"LOW MISMATCH: Mild discrepancy, generally authentic
expression.\"

else:

interpretation = \"MINIMAL MISMATCH: Strong alignment between inner and
outer layers.\"

return {

\'inner_kosha\': inner_kosha,

\'outer_ontology\': outer_ontology,

\'base_gap\': round(base_gap, 4),

\'entropy_component\': round(entropy_component, 4),

\'stability_component\': round(stability_component, 4),

\'SMI\': round(SMI, 4),

\'interpretation\': interpretation

}

**PART IV: MULTI-WORD SENTENCE ANALYZER**

**4.1 Complete Sentence Pipeline**

def analyze_sentence_complete(text: str) -\> dict:

\"\"\"

Complete pipeline: sentence → kosha/ontology tensors + SMI.

Returns:

{

\'text\': str,

\'tokens\': list,

\'word_analyses\': list,

\'kosha_tensor\': np.ndarray, \# shape: (num_words, 5)

\'ontology_tensor\': np.ndarray, \# shape: (num_words, 10)

\'sentence_kosha_distribution\': dict,

\'sentence_ontology_distribution\': dict,

\'average_smi\': float,

\'dominant_inner_kosha\': str,

\'dominant_outer_ontology\': str,

\'overall_tension\': float

}

\"\"\"

import numpy as np

from collections import Counter

\# Tokenize

words = tokenize(text)

word_analyses = \[\]

kosha_tensor = \[\]

ontology_tensor = \[\]

kosha_counts = Counter()

onto_counts = Counter()

smi_scores = \[\]

for word in words:

\# Analyze koshas

kosha_info = analyze_word_koshas(word)

\# Get ontology

onto_info = get_ontology_from_word(word)

\# Build kosha distribution vector (length 5)

kosha_vec = \[kosha_info\[\'distribution\'\].get(k, 0) for k in range(1,
6)\]

kosha_tensor.append(kosha_vec)

\# Build ontology one-hot vector (length 10)

onto_vec = \[0\] \* 10

onto_vec\[onto_info\[\'ontology_id\'\] - 1\] = 1

ontology_tensor.append(onto_vec)

\# Compute SMI for this word

smi = compute_smi(

kosha_info\[\'dominant_kosha_id\'\],

onto_info\[\'ontology_id\'\]

)

smi_scores.append(smi\[\'SMI\'\])

\# Accumulate counts

for k, prob in kosha_info\[\'distribution\'\].items():

kosha_counts\[k\] += prob

onto_counts\[onto_info\[\'ontology_id\'\]\] += 1

word_analyses.append({

\'word\': word,

\'kosha\': kosha_info,

\'ontology\': onto_info,

\'smi\': smi\[\'SMI\'\]

})

\# Sentence-level distributions

kosha_total = sum(kosha_counts.values()) or 1

sentence_kosha = {

KOSHA_ID_TO_NAME\[k\]: kosha_counts\[k\] / kosha_total

for k in range(1, 6)

}

onto_total = sum(onto_counts.values()) or 1

sentence_onto = {

ONTO_ID_TO_NAME\[k\]: onto_counts\[k\] / onto_total

for k in range(1, 11)

}

\# Dominant layers

dominant_kosha = max(sentence_kosha, key=sentence_kosha.get)

dominant_onto = max(sentence_onto, key=sentence_onto.get)

\# Average SMI

avg_smi = np.mean(smi_scores) if smi_scores else 0

\# Overall tension (between dominant layers)

dominant_kosha_id = \[k for k, v in KOSHA_ID_TO_NAME.items() if v ==
dominant_kosha\]\[0\]

dominant_onto_id = \[k for k, v in ONTO_ID_TO_NAME.items() if v ==
dominant_onto\]\[0\]

overall_tension = abs(dominant_kosha_id/5.0 - dominant_onto_id/10.0)

return {

\'text\': text,

\'tokens\': words,

\'word_analyses\': word_analyses,

\'kosha_tensor\': np.array(kosha_tensor),

\'ontology_tensor\': np.array(ontology_tensor),

\'sentence_kosha_distribution\': sentence_kosha,

\'sentence_ontology_distribution\': sentence_onto,

\'average_smi\': round(avg_smi, 4),

\'dominant_inner_kosha\': dominant_kosha,

\'dominant_outer_ontology\': dominant_onto,

\'overall_tension\': round(overall_tension, 4)

}

