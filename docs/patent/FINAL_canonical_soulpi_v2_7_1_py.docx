class FinalCanonicalSoulpiEngine:

\"\"\"

Final canonical Soulpi engine with authoritative mappings.

\"\"\"

def \_\_init\_\_(self):

self.consonant_map = CONSONANT_TO_KOSHA_MAP

self.kosha_layers = CANONICAL_KOSHA_LAYERS

def get_consonant_kosha(self, consonant: str) -\> dict:

\"\"\"

Get Kosha mapping for a consonant.

Args:

consonant: Single consonant or consonant cluster

Returns:

Dictionary with kosha, level, qualities, vritti, acoustic

\"\"\"

\# Normalize input

consonant_lower = consonant.lower()

\# Try exact match

if consonant_lower in self.consonant_map:

return self.consonant_map\[consonant_lower\]

\# Try first character

if consonant_lower\[0\] in self.consonant_map:

return self.consonant_map\[consonant_lower\[0\]\]

\# Default to ANNAMAYA if unknown

return {

\'kosha\': \'ANNAMAYA\',

\'level\': 1,

\'qualities\': \[\'Unknown (defaulted to material)\'\],

\'vritti\': \'Nidrā\',

\'acoustic\': \'Unknown\'

}

def analyze_word(self, word: str) -\> dict:

\"\"\"

Analyze word using canonical mappings.

\"\"\"

\# Extract consonants (simplified - real impl uses proper syllabifier)

vowels = set(\'aāiīuūeēoōaiauṛṝḷḹ\')

consonants = \[\]

i = 0

while i \< len(word):

if word\[i\].lower() not in vowels:

\# Collect consonant cluster

cluster = \'\'

while i \< len(word) and word\[i\].lower() not in vowels:

cluster += word\[i\].lower()

i += 1

consonants.append(cluster)

else:

i += 1

\# Map each consonant to kosha

kosha_counts = {

\'ANNAMAYA\': 0,

\'PRANAMAYA\': 0,

\'MANOMAYA\': 0,

\'VIJNANAMAYA\': 0,

\'ANANDAMAYA\': 0

}

consonant_analyses = \[\]

for cons in consonants:

kosha_info = self.get_consonant_kosha(cons)

kosha_counts\[kosha_info\[\'kosha\'\]\] += 1

consonant_analyses.append({

\'consonant\': cons,

\'kosha\': kosha_info\[\'kosha\'\],

\'level\': kosha_info\[\'level\'\],

\'vritti\': kosha_info\[\'vritti\'\]

})

\# Normalize distribution

total = sum(kosha_counts.values())

kosha_distribution = {

k: v/total for k, v in kosha_counts.items()

} if total \> 0 else {}

\# Find dominant kosha

dominant_kosha = max(kosha_distribution, key=kosha_distribution.get) if
kosha_distribution else \'ANNAMAYA\'

return {

\'word\': word,

\'consonants\': consonants,

\'consonant_analyses\': consonant_analyses,

\'kosha_distribution\': kosha_distribution,

\'dominant_kosha\': dominant_kosha

}

def visualize_analysis(self, word: str) -\> str:

\"\"\"Visualize word analysis.\"\"\"

analysis = self.analyze_word(word)

viz = f\"\\n{\'=\'\*70}\\n\"

viz += f\"CANONICAL SOULPI ANALYSIS: \'{word.upper()}\'\\n\"

viz += f\"{\'=\'\*70}\\n\\n\"

viz += \"Consonants:\\n\"

for ca in analysis\[\'consonant_analyses\'\]:

viz += f\" {ca\[\'consonant\'\]:6s} → {ca\[\'kosha\'\]:15s} (Level
{ca\[\'level\'\]}) \| {ca\[\'vritti\'\]}\\n\"

viz += f\"\\nKosha Distribution:\\n\"

for kosha, prob in sorted(analysis\[\'kosha_distribution\'\].items(), 

key=lambda x: x\[1\], reverse=True):

if prob \> 0:

bar = \'█\' \* int(prob \* 30)

viz += f\" {kosha:15s} {prob:5.1%} {bar}\\n\"

viz += f\"\\nDominant Kosha: {analysis\[\'dominant_kosha\'\]}\\n\"

viz += f\"{\'=\'\*70}\\n\"

return viz

