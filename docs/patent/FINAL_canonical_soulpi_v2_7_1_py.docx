CANONICAL_KOSHA_LAYERS = {

1: \'ANNAMAYA\',

2: \'PRANAMAYA\', 

3: \'MANOMAYA\',

4: \'VIJNANAMAYA\',

5: \'ANANDAMAYA\'

}

CANONICAL_CONSONANT_TO_KOSHA = {

\# ═══════════════════════════════════════════════════

\# 1. ANNAMAYA (Physical/Dense)

\# ═══════════════════════════════════════════════════

\# Body-bound, dense vrttis: indifference, obsession, 

\# indulgence, body-tension

\'ANNAMAYA\': {

\'consonants\': \[\'ba\', \'bha\', \'ma\', \'ya\', \'ra\', \'la\'\],

\'devanagari\': \[\'ब\', \'भ\', \'म\', \'य\', \'र\', \'ल\'\],

\'qualities\': \[

\'Indifference\',

\'Obsession\',

\'Indulgence\', 

\'Body-tension\',

\'Dense materiality\',

\'Physical fixation\'

\],

\'vritti_tendency\': \'Nidrā (inertness, sleep, dullness)\',

\'acoustic_quality\': \'Heavy, dragging, grounded, viscous\',

\'explanation\': (

\'Body-bound consciousness. These consonants create dense, \'

\'heavy acoustic signatures that bind awareness to physical form.\'

)

},

\# ═══════════════════════════════════════════════════

\# 2. PRANAMAYA (Pranic/Energy)

\# ═══════════════════════════════════════════════════

\# Agitation, projection, breath-force turbulence, 

\# energetic push-pull

\'PRANAMAYA\': {

\'consonants\': \[\'ka\', \'kha\', \'ga\', \'gha\', \'ṅa\', \'ca\',
\'cha\'\],

\'devanagari\': \[\'क\', \'ख\', \'ग\', \'घ\', \'ङ\', \'च\', \'छ\'\],

\'qualities\': \[

\'Agitation\',

\'Projection\',

\'Breath-force turbulence\',

\'Energetic push-pull\',

\'Restless propulsion\',

\'Vital force instability\'

\],

\'vritti_tendency\': \'Vikalpa (restless imagination, energetic
fantasy)\',

\'acoustic_quality\': \'Explosive, projective, turbulent, pushing\',

\'explanation\': (

\'Pranic energy consciousness. These consonants create explosive, \'

\'propulsive acoustic signatures that manifest as energetic agitation.\'

)

},

\# ═══════════════════════════════════════════════════

\# 3. MANOMAYA (Emotional/Mind)

\# ═══════════════════════════════════════════════════

\# Emotional turbulence: fear, craving, delusion, anger, sadness

\'MANOMAYA\': {

\'consonants\': \[

\'ḍa\', \'ḍha\', \'ṇa\', \# Retroflexes

\'ta\', \'tha\', \'da\', \'dha\', \'na\', \# Dentals

\'pa\', \'pha\' \# Labials

\],

\'devanagari\': \[\'ड\', \'ढ\', \'ण\', \'त\', \'थ\', \'द\', \'ध\',
\'न\', \'प\', \'फ\'\],

\'qualities\': \[

\'Fear\',

\'Craving\',

\'Delusion\',

\'Anger\', 

\'Sadness\',

\'Emotional volatility\'

\],

\'vritti_tendency\': \'Viparyaya (misperception, emotional
distortion)\',

\'acoustic_quality\': \'Sharp, cutting, emotional, turbulent\',

\'explanation\': (

\'Mind-emotional consciousness. These consonants create sharp, \'

\'cutting acoustic signatures that manifest as emotional turbulence.\'

)

},

\# ═══════════════════════════════════════════════════

\# 4. VIJNANAMAYA (Wisdom/Discrimination)

\# ═══════════════════════════════════════════════════

\# Cognitive/ego distortions resolved by discrimination: 

\# vanity, hypocrisy, false knowledge

\'VIJNANAMAYA\': {

\'consonants\': \[

\'ja\', \'jha\', \'ña\', \# Palatals

\'ṭa\', \'ṭha\', \# Retroflexes (stops)

\'śa\', \'ṣa\', \'sa\', \# Sibilants

\'kṣa\' \# Conjunct

\],

\'devanagari\': \[\'ज\', \'झ\', \'ञ\', \'ट\', \'ठ\', \'श\', \'ष\',
\'स\', \'क्ष\'\],

\'qualities\': \[

\'Discrimination\',

\'Vanity (to be resolved)\',

\'Hypocrisy (to be resolved)\',

\'False knowledge (to be resolved)\',

\'Cognitive distortion (to be resolved)\',

\'Penetrating analysis\'

\],

\'vritti_tendency\': \'Pramāṇa (valid cognition, discrimination)\',

\'acoustic_quality\': \'Penetrating, sibilant, sharp, discriminating\',

\'explanation\': (

\'Wisdom consciousness. These consonants create penetrating, \'

\'sibilant acoustic signatures that cut through illusion with \'

\'discriminative power.\'

)

},

\# ═══════════════════════════════════════════════════

\# 5. ANANDAMAYA (Bliss/Pure Being)

\# ═══════════════════════════════════════════════════

\# No consonants originate here; only vowels rise into this layer

\'ANANDAMAYA\': {

\'consonants\': \[\],

\'devanagari\': \[\],

\'qualities\': \[

\'Pure bliss\',

\'Non-dual awareness\',

\'Transcendent being\',

\'Causeless peace\',

\'Ultimate stillness\'

\],

