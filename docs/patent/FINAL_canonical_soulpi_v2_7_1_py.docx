\# ═══════════════════════════════════════════════════

\# REVERSE MAP: Consonant → Kosha (for fast lookup)

\# ═══════════════════════════════════════════════════

CONSONANT_TO_KOSHA_MAP = {}

for kosha, data in CANONICAL_CONSONANT_TO_KOSHA.items():

for consonant in data\[\'consonants\'\]:

CONSONANT_TO_KOSHA_MAP\[consonant\] = {

\'kosha\': kosha,

\'level\': \[k for k, v in CANONICAL_KOSHA_LAYERS.items() if v ==
kosha\]\[0\],

\'qualities\': data\[\'qualities\'\],

\'vritti\': data\[\'vritti_tendency\'\],

\'acoustic\': data\[\'acoustic_quality\'\]

}

\# Add uppercase and variant mappings

CONSONANT_VARIANTS = {

\'ba\': \[\'b\', \'B\', \'ba\', \'Ba\'\],

\'bha\': \[\'bh\', \'Bh\', \'bha\', \'Bha\'\],

\'ma\': \[\'m\', \'M\', \'ma\', \'Ma\'\],

\'ya\': \[\'y\', \'Y\', \'ya\', \'Ya\'\],

\'ra\': \[\'r\', \'R\', \'ra\', \'Ra\'\],

\'la\': \[\'l\', \'L\', \'la\', \'La\'\],

\'ka\': \[\'k\', \'K\', \'ka\', \'Ka\'\],

\'kha\': \[\'kh\', \'Kh\', \'kha\', \'Kha\'\],

\'ga\': \[\'g\', \'G\', \'ga\', \'Ga\'\],

\'gha\': \[\'gh\', \'Gh\', \'gha\', \'Gha\'\],

\'ṅa\': \[\'ng\', \'ṅ\', \'ṅa\'\],

\'ca\': \[\'c\', \'C\', \'ca\', \'Ca\', \'ch\', \'Ch\'\], \# Note:
\'ch\' often for \'ca\'

\'cha\': \[\'ch\', \'Ch\', \'cha\', \'Cha\', \'chh\'\],

\'ja\': \[\'j\', \'J\', \'ja\', \'Ja\'\],

\'jha\': \[\'jh\', \'Jh\', \'jha\', \'Jha\'\],

\'ña\': \[\'ñ\', \'ny\', \'ña\'\],

\'ṭa\': \[\'ṭ\', \'ta\', \'Ta\'\], \# Retroflex

\'ṭha\': \[\'ṭh\', \'tha\', \'Tha\'\], \# Retroflex

\'ḍa\': \[\'ḍ\', \'da\', \'Da\'\], \# Retroflex

\'ḍha\': \[\'ḍh\', \'dha\', \'Dha\'\], \# Retroflex

\'ṇa\': \[\'ṇ\', \'na\', \'Na\'\], \# Retroflex

\'ta\': \[\'t\', \'T\', \'ta\', \'Ta\'\], \# Dental

\'tha\': \[\'th\', \'Th\', \'tha\', \'Tha\'\], \# Dental

\'da\': \[\'d\', \'D\', \'da\', \'Da\'\], \# Dental

\'dha\': \[\'dh\', \'Dh\', \'dha\', \'Dha\'\], \# Dental

\'na\': \[\'n\', \'N\', \'na\', \'Na\'\], \# Dental

\'pa\': \[\'p\', \'P\', \'pa\', \'Pa\'\],

\'pha\': \[\'ph\', \'Ph\', \'pha\', \'Pha\', \'f\', \'F\'\],

\'śa\': \[\'ś\', \'sh\', \'Sh\', \'sha\', \'Sha\'\], \# Palatal

\'ṣa\': \[\'ṣ\', \'sh\', \'Sh\'\], \# Retroflex

\'sa\': \[\'s\', \'S\', \'sa\', \'Sa\'\],

\'kṣa\': \[\'kṣ\', \'ksh\', \'Ksh\', \'ksha\', \'x\'\]

}

\# Expand CONSONANT_TO_KOSHA_MAP with variants

for canonical, variants in CONSONANT_VARIANTS.items():

if canonical in CONSONANT_TO_KOSHA_MAP:

base_info = CONSONANT_TO_KOSHA_MAP\[canonical\]

for variant in variants:

if variant not in CONSONANT_TO_KOSHA_MAP:

CONSONANT_TO_KOSHA_MAP\[variant\] = base_info.copy()

