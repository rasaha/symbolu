**Part 6: CANONICAL SOULPI ENGINE (CORRECTED)**

#!/usr/bin/env python3

\"\"\"

CANONICAL Soulpi Engine v2.7.1

Corrected Kosha-Consonant + True Ontology

\"\"\"

class CanonicalSoulpiEngine:

\"\"\"

Canonical Soulpi engine with corrected mappings.

\"\"\"

def \_\_init\_\_(self):

self.consonant_map = CANONICAL_CONSONANT_KOSHA_MAP

self.ontology_layers = CANONICAL_ONTOLOGY_LAYERS

self.kosha_vritti_map = CANONICAL_KOSHA_VRITTI_MAP

def map_consonant_to_kosha(self, consonant: str) -\> Dict:

\"\"\"

Map consonant to Kosha with dual-state handling for K.

Returns kosha info including purification state.

\"\"\"

c_upper = consonant.upper()

if c_upper == \'K\':

\# K has dual states - return both

return {

\'consonant\': \'K\',

\'has_dual_state\': True,

\'base_kosha\': \'Pranamaya\',

\'purified_kosha\': \'Vijnanamaya\',

\'default_kosha\': \'Pranamaya\', \# Use unpurified by default

\'base_vritti\': \'Vikalpa\',

\'purified_vritti\': \'Pramāṇa\'

}

elif c_upper in self.consonant_map:

info = self.consonant_map\[c_upper\]

return {

\'consonant\': c_upper,

\'has_dual_state\': False,

\'kosha\': info\[\'kosha\'\],

\'vritti\': info\[\'vritti\'\],

\'quality\': info\[\'quality\'\]

}

else:

\# Unknown consonant - default to Annamaya

return {

\'consonant\': c_upper,

\'has_dual_state\': False,

\'kosha\': \'Annamaya\',

\'vritti\': \'Nidrā\',

\'quality\': \'Unknown (defaulted to material)\'

}

def determine_k_purification(self, syllable_context: str, 

vowel: str) -\> str:

\"\"\"

Determine if K is purified based on context.

Heuristics:

\- Long vowels (Ī, Ū, Ā) → purification more likely

\- Spiritual/wisdom words → purification

\- Default → unpurified (Pranamaya)

\"\"\"

\# For now, use simple heuristic

\# In full implementation, would use semantic analysis

long_vowels = {\'Ī\', \'Ū\', \'Ā\', \'Ō\', \'Ai\', \'Au\'}

if vowel in long_vowels:

\# Long vowel suggests upward lift

return \'Vijnanamaya\'

else:

\# Default to unpurified

return \'Pranamaya\'

def analyze_word_canonical(self, word: str, 

cultural_meaning: str = None) -\> Dict:

\"\"\"

Canonical word analysis with corrected mappings.

\"\"\"

word_lower = word.lower()

\# Extract syllables (simplified - use real syllabifier in production)

syllables = self.\_decompose_syllables(word_lower)

\# INNER: Consonants → Kosha

kosha_counts = {

\'Annamaya\': 0,

\'Pranamaya\': 0,

\'Manomaya\': 0,

\'Vijnanamaya\': 0,

\'Anandamaya\': 0

}

for syllable in syllables:

\# Extract consonant and vowel

consonant, vowel = self.\_split_syllable(syllable)

if consonant:

cons_info = self.map_consonant_to_kosha(consonant)

if cons_info.get(\'has_dual_state\'):

\# Handle K dual state

kosha = self.determine_k_purification(word, vowel)

kosha_counts\[kosha\] += 1

else:

kosha = cons_info\[\'kosha\'\]

kosha_counts\[kosha\] += 1

else:

\# Pure vowel → Anandamaya

kosha_counts\[\'Anandamaya\'\] += 1

\# Normalize Kosha distribution

total = sum(kosha_counts.values())

kosha_dist = {k: v/total for k, v in kosha_counts.items()} if total \> 0
else {}

\# OUTER: Semantic → Ontology

ontology_dist = self.\_map_semantic_to_ontology(word, cultural_meaning)

\# Compute tension

dominant_kosha = max(kosha_dist, key=kosha_dist.get) if kosha_dist else
\'Annamaya\'

dominant_ontology = max(ontology_dist, key=ontology_dist.get) if
ontology_dist else \'Execution\'

tension = self.\_compute_tension_canonical(dominant_kosha,
dominant_ontology)

return {

\'word\': word,

\'kosha_distribution\': kosha_dist,

\'dominant_kosha\': dominant_kosha,

\'ontology_distribution\': ontology_dist,

\'dominant_ontology\': dominant_ontology,

\'tension\': tension

}

def \_compute_tension_canonical(self, kosha: str, ontology: str) -\>
float:

\"\"\"Compute tension using canonical ladder.\"\"\"

kosha_depth = {

\'Annamaya\': 0.2,

\'Pranamaya\': 0.4,

\'Manomaya\': 0.6,

\'Vijnanamaya\': 0.8,

\'Anandamaya\': 1.0

}

ontology_height = {

\'Execution\': 0.1,

\'Identity\': 0.2,

\'Form\': 0.3,

\'Cognition\': 0.4,

\'Agency\': 0.5,

\'Reasoning\': 0.6,

\'Purpose\': 0.7,

\'Observation\': 0.8,

\'Core\': 0.9,

\'Universal\': 1.0

}

k_depth = kosha_depth.get(kosha, 0.5)

o_height = ontology_height.get(ontology, 0.5)

return abs(k_depth - o_height)

