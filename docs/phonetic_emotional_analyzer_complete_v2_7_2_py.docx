**============================================================================**

**PART III: ANALYSIS FUNCTIONS**

**============================================================================**

def analyze_consonant_emotion(consonant: str) -\>
Optional\[ConsonantProfile\]: """ Get complete emotional profile for a
consonant.

Args:

consonant: e.g., \'r\', \'ra\', \'ka\', \'sha\'

Returns:

ConsonantProfile or None if not found

\"\"\"

\# Normalize

cons = consonant.lower()

\# Try direct lookup

if cons in CONSONANT_EMOTIONAL_MAP:

return CONSONANT_EMOTIONAL_MAP\[cons\]

\# Try with \'a\' appended (e.g., \'k\' → \'ka\')

if cons + \'a\' in CONSONANT_EMOTIONAL_MAP:

return CONSONANT_EMOTIONAL_MAP\[cons + \'a\'\]

return None

def analyze_vowel_emotion(vowel: str) -\> Optional\[VowelProfile\]: """
Get complete emotional-aspect profile for a vowel.

Args:

vowel: e.g., \'a\', \'ā\', \'i\', \'e\', \'ai\'

Returns:

VowelProfile or None if not found

\"\"\"

v = vowel.lower()

return VOWEL_EMOTIONAL_MAP.get(v)

def analyze_syllable_complete(syllable: str) -\> Dict: """ Complete
phonetic-emotional analysis of a syllable.

Args:

syllable: e.g., \'ra\', \'ke\', \'sha\', \'om\'

Returns:

{

\'syllable\': str,

\'consonant\': ConsonantProfile or None,

\'vowel\': VowelProfile or None,

\'combined_emotion\': str,

\'spiritual_trajectory\': str,

\'therapeutic_note\': str

}

\"\"\"

syll = syllable.lower()

\# Extract consonant (first 1-3 chars)

consonant_profile = None

for length in (3, 2, 1):

if len(syll) \>= length:

cons = syll\[:length\]

consonant_profile = analyze_consonant_emotion(cons)

if consonant_profile:

vowel_part = syll\[length:\]

break

else:

vowel_part = syll

\# Extract vowel

vowel_profile = analyze_vowel_emotion(vowel_part) if vowel_part else
None

\# Synthesize combined meaning

if consonant_profile and vowel_profile:

combined = f\"{consonant_profile.negative_emotion} directed
{vowel_profile.direction} → {vowel_profile.aspect_bridge_target}\"

trajectory = f\"From {consonant_profile.kosha_name} through
{vowel_profile.aspect_bridge_source} toward
{vowel_profile.aspect_bridge_target}\"

therapeutic = f\"Consonant work: {consonant_profile.therapeutic_note}.
Vowel work: {vowel_profile.therapeutic_use}\"

elif consonant_profile:

combined = consonant_profile.negative_emotion

trajectory = f\"Stuck in {consonant_profile.kosha_name} without vowel
direction\"

therapeutic = consonant_profile.therapeutic_note

elif vowel_profile:

combined = f\"Pure vowel: {vowel_profile.emotional_valence}\"

trajectory = f\"Direct {vowel_profile.aspect_bridge_source} →
{vowel_profile.aspect_bridge_target}\"

therapeutic = vowel_profile.therapeutic_use

else:

combined = \"Unknown syllable\"

trajectory = \"Cannot determine\"

therapeutic = \"Check transliteration\"

return {

\'syllable\': syllable,

\'consonant\': consonant_profile,

\'vowel\': vowel_profile,

\'combined_emotion\': combined,

\'spiritual_trajectory\': trajectory,

\'therapeutic_note\': therapeutic

}

def analyze_word_emotional_journey(word: str) -\> Dict: """ Analyze
complete emotional journey through a word.

Args:

word: e.g., \'Rakesh\', \'love\', \'karma\'

Returns:

{

\'word\': str,

\'syllables\': \[Dict\],

\'emotional_arc\': str,

\'kosha_journey\': str,

\'aspect_journey\': str,

\'therapeutic_approach\': str

}

\"\"\"

from core.kosha import split_syllables \# Reuse from main code

syllables = split_syllables(word)

analyses = \[analyze_syllable_complete(s) for s in syllables\]

\# Track kosha journey

koshas = \[a\[\'consonant\'\].kosha_name for a in analyses if
a\[\'consonant\'\]\]

kosha_journey = \" → \".join(koshas) if koshas else \"No consonants\"

\# Track aspect journey

aspects = \[a\[\'vowel\'\].aspect_bridge_target for a in analyses if
a\[\'vowel\'\]\]

aspect_journey = \" → \".join(aspects) if aspects else \"No clear
aspects\"

\# Emotional arc

emotions = \[a\[\'combined_emotion\'\] for a in analyses\]

emotional_arc = \" \| \".join(emotions)

\# Therapeutic synthesis

therapeutic_notes = \[a\[\'therapeutic_note\'\] for a in analyses\]

therapeutic_approach = \"\\n\".join(f\"{i+1}. {note}\" for i, note in
enumerate(therapeutic_notes))

return {

\'word\': word,

\'syllables\': analyses,

\'emotional_arc\': emotional_arc,

\'kosha_journey\': kosha_journey,

\'aspect_journey\': aspect_journey,

\'therapeutic_approach\': therapeutic_approach

}

