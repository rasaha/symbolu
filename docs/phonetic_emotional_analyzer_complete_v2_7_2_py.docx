PHONETIC-EMOTIONAL ANALYZER v2.7.2") print("="\*80)

\# Example 1: Single consonants

print(\"\\n\" + \"=\"\*80)

print(\"EXAMPLE 1: CONSONANT EMOTIONAL PROFILES\")

print(\"=\"\*80)

for cons in \[\'ra\', \'ka\', \'sha\', \'ma\'\]:

profile = analyze_consonant_emotion(cons)

if profile:

print(f\"\\n{profile.transliteration.upper()} ({profile.devanagari})\")

print(f\" Kosha: {profile.kosha_name}\")

print(f\" Negative: {profile.negative_emotion}\")

print(f\" Positive: {profile.positive_potential}\")

print(f\" Pattern: {profile.psychological_pattern}\")

\# Example 2: Vowels

print(\"\\n\" + \"=\"\*80)

print(\"EXAMPLE 2: VOWEL EMOTIONAL-ASPECT PROFILES\")

print(\"=\"\*80)

for vowel in \[\'a\', \'i\', \'e\', \'o\', \'au\'\]:

profile = analyze_vowel_emotion(vowel)

if profile:

print(f\"\\n{profile.transliteration.upper()} ({profile.devanagari})\")

print(f\" Bridge: {profile.aspect_bridge_source} →
{profile.aspect_bridge_target}\")

print(f\" Direction: {profile.direction}\")

print(f\" Positive: {profile.positive_emotion}\")

print(f\" Negative: {profile.negative_emotion}\")

\# Example 3: Complete word analysis

print(\"\\n\" + \"=\"\*80)

print(\"EXAMPLE 3: COMPLETE WORD EMOTIONAL JOURNEY\")

print(\"=\"\*80)

for word in \[\'Rakesh\', \'love\', \'karma\', \'om\'\]:

print(f\"\\n{\'=\'\*80}\")

print(f\"WORD: {word.upper()}\")

print(f\"{\'=\'\*80}\")

analysis = analyze_word_emotional_journey(word)

print(f\"\\nEmotional Arc:\")

print(f\" {analysis\[\'emotional_arc\'\]}\")

print(f\"\\nKosha Journey:\")

print(f\" {analysis\[\'kosha_journey\'\]}\")

print(f\"\\nAspect Journey:\")

print(f\" {analysis\[\'aspect_journey\'\]}\")

print(f\"\\nTherapeutic Approach:\")

for line in analysis\[\'therapeutic_approach\'\].split(\'\\n\'):

print(f\" {line}\")

print(\"\\n\" + \"=\"\*80)

print(\"Analysis complete. All 44 consonants + 14 vowels covered.\")

print(\"=\"\*80)
