{
  "status": "PROPOSED",
  "version": "action_clearance.design.v0.1",
  "description": "Design artifact, NOT a committed runtime contract. Deterministic behavioral scenario matrix for the Action Clearance evaluator and execution boundary. Statuses: CLEAR | HOLD | BLOCK | ESCALATE. 'no_evaluation' and 'dispatch_prohibited' denote error/boundary outcomes rather than evaluator statuses.",
  "scenarios": [
    {"id": 1, "name": "valid authorization + all signals valid", "status": "CLEAR", "reason_codes": ["CLEARANCE_GRANTED"], "retry": false, "fresh_request": false, "human": false, "reauth": false, "owner_response": "dispatch (reserve one-time use)"},
    {"id": 2, "name": "ActionGate denied", "status": "no_evaluation", "reason_codes": ["NON_RETRYABLE_ERROR"], "retry": false, "fresh_request": false, "human": false, "reauth": true, "owner_response": "not clearable; re-authorize upstream"},
    {"id": 3, "name": "authorization expired", "status": "BLOCK", "reason_codes": ["AUTHORIZATION_EXPIRED", "UPSTREAM_REAUTHORIZATION_REQUIRED"], "retry": false, "fresh_request": true, "human": false, "reauth": true, "owner_response": "re-authorize"},
    {"id": 4, "name": "action fingerprint mismatch", "status": "BLOCK", "reason_codes": ["ACTION_FINGERPRINT_MISMATCH"], "retry": false, "fresh_request": true, "human": false, "reauth": true, "owner_response": "new authorization + clearance"},
    {"id": 5, "name": "target mismatch", "status": "BLOCK", "reason_codes": ["TARGET_MISMATCH"], "retry": false, "fresh_request": true, "human": false, "reauth": true, "owner_response": "correct target; re-authorize"},
    {"id": 6, "name": "active freeze", "status": "HOLD", "reason_codes": ["ACTIVE_CHANGE_FREEZE"], "retry": true, "fresh_request": true, "human": false, "reauth": false, "owner_response": "retry after freeze lifts"},
    {"id": 7, "name": "active incident", "status": "HOLD", "status_alt": "ESCALATE", "reason_codes": ["ACTIVE_INCIDENT"], "retry": true, "fresh_request": true, "human": "by policy", "reauth": false, "owner_response": "wait / human decision"},
    {"id": 8, "name": "actor disabled", "status": "BLOCK", "reason_codes": ["ACTOR_INVALID"], "retry": false, "fresh_request": true, "human": false, "reauth": true, "owner_response": "restore actor or re-authorize"},
    {"id": 9, "name": "actor status unknown", "status": "HOLD", "reason_codes": ["ACTOR_STATUS_UNKNOWN"], "retry": true, "fresh_request": true, "human": false, "reauth": false, "fail_closed": true, "owner_response": "refresh actor signal"},
    {"id": 10, "name": "required signal missing", "status": "HOLD", "reason_codes": ["SIGNAL_MISSING"], "retry": true, "fresh_request": true, "human": false, "reauth": false, "fail_closed": true, "owner_response": "supply the signal"},
    {"id": 11, "name": "signal stale", "status": "HOLD", "status_alt": "BLOCK", "reason_codes": ["SIGNAL_STALE"], "retry": true, "fresh_request": true, "human": false, "reauth": false, "owner_response": "refresh signal"},
    {"id": 12, "name": "signal untrusted", "status": "BLOCK", "reason_codes": ["SIGNAL_UNTRUSTED"], "retry": false, "fresh_request": true, "human": false, "reauth": false, "owner_response": "fix provenance/integrity"},
    {"id": 13, "name": "policy version rejected", "status": "BLOCK", "reason_codes": ["POLICY_VERSION_REJECTED"], "retry": false, "fresh_request": true, "human": false, "reauth": true, "owner_response": "re-authorize under current policy"},
    {"id": 14, "name": "prior consumption recorded", "status": "BLOCK", "reason_codes": ["ALREADY_CONSUMED"], "retry": false, "fresh_request": false, "human": false, "reauth": false, "owner_response": "none (already executed)"},
    {"id": 15, "name": "target temporarily unavailable", "status": "HOLD", "reason_codes": ["TARGET_UNAVAILABLE"], "retry": true, "fresh_request": true, "human": false, "reauth": false, "owner_response": "retry when available"},
    {"id": 16, "name": "conflicting signals", "status": "ESCALATE", "status_alt": "BLOCK", "reason_codes": ["SIGNAL_CONFLICT"], "retry": false, "fresh_request": true, "human": true, "reauth": false, "owner_response": "human resolves"},
    {"id": 17, "name": "clearance validity shortened by signal expiry", "status": "CLEAR", "reason_codes": ["CLEARANCE_GRANTED"], "retry": false, "fresh_request": false, "human": false, "reauth": false, "invariant": "valid_until = min(authorization.expires_at, min signal valid_until, max_lifetime)", "owner_response": "dispatch before shortened valid_until"},
    {"id": 18, "name": "caller retries identical request", "status": "same-as-first", "reason_codes": [], "invariant": "identical result_fingerprint", "retry": false, "owner_response": "idempotent"},
    {"id": 19, "name": "reason-code order varies in input", "status": "unchanged", "reason_codes": [], "invariant": "identical result_fingerprint (canonical ordering)", "retry": false, "owner_response": "order-independent"},
    {"id": 20, "name": "attempt to widen authorization permissions", "status": "ESCALATE", "status_alt": "BLOCK", "reason_codes": ["CONSTRAINT_CONFLICT"], "retry": false, "fresh_request": true, "human": true, "reauth": "if needed", "owner_response": "cannot widen; re-authorize if needed"},
    {"id": 21, "name": "new head SHA requires new clearance", "status": "BLOCK", "reason_codes": ["GITHUB_HEAD_SHA_CHANGED", "ACTION_FINGERPRINT_MISMATCH"], "retry": false, "fresh_request": true, "human": false, "reauth": true, "owner_response": "new authorization + clearance"},
    {"id": 22, "name": "regenerated merge group requires new clearance", "status": "BLOCK", "reason_codes": ["GITHUB_MERGE_GROUP_MISMATCH"], "retry": false, "fresh_request": true, "human": false, "reauth": true, "owner_response": "clear the new merge-group artifact"},
    {"id": 23, "name": "clearance expired before dispatch", "status": "dispatch_prohibited", "reason_codes": ["EXPIRED"], "receipt_state": "EXPIRED", "retry": false, "fresh_request": true, "human": false, "reauth": false, "owner_response": "re-evaluate"},
    {"id": 24, "name": "two concurrent dispatches", "status": "one_reserves_one_duplicate", "reason_codes": ["DISPATCH_DUPLICATE"], "owner": "execution ledger", "retry": false, "owner_response": "ledger arbitrates; exactly one executes"},
    {"id": 25, "name": "upstream authorization superseded", "status": "dispatch_prohibited", "reason_codes": ["REVOKED_BY_UPSTREAM_CHANGE"], "receipt_state": "REVOKED_BY_UPSTREAM_CHANGE", "retry": false, "fresh_request": true, "human": false, "reauth": true, "owner_response": "re-authorize + fresh clearance"}
  ]
}
