{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugence.design/action_clearance_prerequisites/clearance_receipt.schema.json",
  "title": "ClearanceReceipt (Action Clearance prerequisites)",
  "status": "PROPOSED",
  "version": "action_clearance.prerequisites.v0.1",
  "description": "Design artifact, NOT a committed runtime contract. Durable product record persisted by the Workflow Service around a ClearanceResult. Body is immutable; storage/lifecycle metadata are excluded from result_fingerprint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "receipt_version",
    "tenant_id",
    "request_id",
    "authorization_ref",
    "action_governance_result_fingerprint",
    "authorized_action_fingerprint",
    "clearance_status",
    "reason_codes",
    "effective_constraints",
    "obligations",
    "signal_refs",
    "signal_bundle_fingerprint",
    "policy_refs",
    "evaluated_at",
    "valid_until",
    "request_fingerprint",
    "result_fingerprint",
    "created_at",
    "lifecycle_state"
  ],
  "properties": {
    "receipt_id": {"type": "string", "x-partition": "persistence", "x-fingerprinted": false, "description": "acr_<result_fingerprint> (content-addressed storage identity)."},
    "receipt_version": {"type": "string", "x-partition": "persistence", "x-fingerprinted": false, "const": "action_clearance.receipt.v1"},
    "tenant_id": {"type": "string", "x-partition": "evaluator", "x-fingerprinted": true},
    "request_id": {"type": "string", "x-partition": "evaluator", "x-fingerprinted": true},
    "correlation_id": {"type": ["string", "null"], "x-partition": "reconstruction", "x-fingerprinted": false},
    "workflow_id": {"type": ["string", "null"], "x-partition": "reconstruction", "x-fingerprinted": false},
    "decision_record_ref": {"type": "string", "x-partition": "reconstruction", "x-fingerprinted": true},
    "context_envelope_ref": {"type": "string", "x-partition": "reconstruction", "x-fingerprinted": true},
    "context_envelope_hash": {"type": "string", "x-partition": "reconstruction", "x-fingerprinted": true},
    "authorization_ref": {"type": "string", "x-partition": "evaluator", "x-fingerprinted": true},
    "action_governance_result_fingerprint": {"type": "string", "x-partition": "evaluator", "x-fingerprinted": true},
    "authorized_action_fingerprint": {"type": "string", "x-partition": "evaluator", "x-fingerprinted": true},
    "clearance_status": {"type": "string", "enum": ["CLEAR", "HOLD", "BLOCK", "ESCALATE"], "x-partition": "evaluator", "x-fingerprinted": true},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "x-partition": "evaluator", "x-fingerprinted": true, "description": "Canonically ordered; order does not change the fingerprint."},
    "effective_constraints": {"type": "array", "items": {"type": "string"}, "x-partition": "evaluator", "x-fingerprinted": true},
    "obligations": {"type": "array", "items": {"type": "string"}, "x-partition": "evaluator", "x-fingerprinted": true},
    "signal_refs": {"type": "array", "items": {"type": "string"}, "x-partition": "evaluator", "x-fingerprinted": true},
    "signal_bundle_fingerprint": {"type": "string", "x-partition": "evaluator", "x-fingerprinted": true},
    "policy_refs": {"type": "array", "items": {"type": "string"}, "x-partition": "evaluator", "x-fingerprinted": true},
    "evaluated_at": {"type": "string", "x-partition": "evaluator", "x-fingerprinted": true, "description": "Equals request.evaluation_time (caller-supplied)."},
    "valid_until": {"type": "string", "x-partition": "evaluator", "x-fingerprinted": true, "description": "<= authorization.expires_at and <= min(required-signal valid_until)."},
    "request_fingerprint": {"type": "string", "x-partition": "evaluator", "x-fingerprinted": true},
    "result_fingerprint": {"type": "string", "x-partition": "evaluator", "x-fingerprinted": "self", "description": "Content address of all fingerprinted fields."},
    "created_at": {"type": "string", "x-partition": "persistence", "x-fingerprinted": false, "description": "Wall-clock issue time (workflow layer)."},
    "lifecycle_state": {"type": "string", "enum": ["ISSUED", "EXPIRED", "SUPERSEDED", "REVOKED", "INVALIDATED"], "x-partition": "lifecycle", "x-fingerprinted": false},
    "supersedes": {"type": ["string", "null"], "x-partition": "lifecycle", "x-fingerprinted": false},
    "superseded_by": {"type": ["string", "null"], "x-partition": "lifecycle", "x-fingerprinted": false},
    "revocation_ref": {"type": ["string", "null"], "x-partition": "lifecycle", "x-fingerprinted": false}
  },
  "x-prohibited": ["credentials", "provider commands", "mutable external state", "secrets", "live tokens"],
  "x-identity": {
    "evaluation_identity": "acr_<result_fingerprint>",
    "storage_identity": "receipt_id = acr_<result_fingerprint> (primary) + optional monotonic lifecycle-event sequence",
    "body_immutable": true,
    "lifecycle_model": "append-only events / linked records"
  }
}
