def test_retrieval_entropy():

\"\"\"Test retrieval entropy computation.\"\"\"

snippets = \[\"AI is transforming technology.\", \"Machine learning
enables predictions.\"\]

scores = \[0.9, 0.8\]

H, P = compute_retrieval_entropy(snippets, scores)

assert 0 \<= H \<= 1

assert np.isclose(np.sum(P), 1.0)

def test_convergence_detection():

\"\"\"Test convergence tracker.\"\"\"

tracker = ConvergenceTracker(epsilon_stability=0.02)

states = \[

{\'H_dim\': 0.5, \'lambda_ctx\': 0.6},

{\'H_dim\': 0.48, \'lambda_ctx\': 0.62},

{\'H_dim\': 0.475, \'lambda_ctx\': 0.625} \# Should converge

\]

for state in states:

converged, boost = tracker.update(state)

assert converged == True

def test_beam_expansion():

\"\"\"Test beam size adaptation.\"\"\"

controller = BeamExpansionController()

beam, expanded, reason = controller.compute_beam_size(

confidence=0.5, H_dim_norm=0.7, H_Guna_norm=0.6, mode=\'v2.6_stitch\'

)

assert expanded == True

assert beam \> 10

