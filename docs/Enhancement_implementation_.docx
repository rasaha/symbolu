def decide_mode_v3_full_enhanced(

\# Core metrics

FC: float, CA: float, UT: float, QC: float,

\# Corpus

corpus_size: int,

corpus_snippets: List\[str\],

retrieval_enabled: bool,

retrieval_quality: float,

retrieval_quality_scores: List\[float\],

\# Entropy (patent)

H_dim: float, H_Guna: float, H_Kosha: float,

\# Vritti

p_v: np.ndarray,

p_w_var: float, s_c: float, u_v: float,

\# Operational

latency_budget_ms: float,

iteration: int,

max_iterations: int,

last_mode: Optional\[str\] = None,

last_score: Optional\[float\] = None,

\# Enhancement controllers (persistent across calls)

convergence_tracker: ConvergenceTracker = None,

beam_controller: BeamExpansionController = None,

mirror_engine: MirrorLogicEngine = None,

threshold_controller: AdaptiveThresholdController = None,

sync_controller: DistributedSyncController = None,

\# Deferred insights

deferred_insights: List\[Dict\] = None,

current_time: float = None

) -\> Tuple\[str, str, int, Dict\]:

\"\"\"

Complete enhanced decision kernel with all Section 5.2 & 5.3 features.

Returns:

mode: str

submode: str

beam_size: int

diagnostics: dict

\"\"\"

\# Initialize controllers if not provided

if convergence_tracker is None:

convergence_tracker = ConvergenceTracker()

if beam_controller is None:

beam_controller = BeamExpansionController()

if mirror_engine is None:

mirror_engine = MirrorLogicEngine()

if threshold_controller is None:

threshold_controller = AdaptiveThresholdController()

diagnostics = {\'timestamp\': time.time(), \'iteration\': iteration}

\# ========== SECTION 5.2 ENHANCEMENTS ==========

\# Enhancement 1: Retrieval as Kosha Layer

if corpus_snippets and retrieval_quality_scores:

H_retrieval_norm, P_retrieval = compute_retrieval_entropy(

corpus_snippets, retrieval_quality_scores

)

Hhat = integrate_retrieval_into_hhat(

H_dim_norm, H_Guna_norm, H_Kosha_norm,

H_retrieval_norm, retrieval_enabled=True

)

diagnostics\[\'H_retrieval\'\] = H_retrieval_norm

else:

Hhat = 0.5 \* H_dim_norm + 0.3 \* H_Guna_norm + 0.2 \* H_Kosha_norm

diagnostics\[\'H_retrieval\'\] = None

\# Enhancement 2: Adaptive Thresholds

threshold_controller.update_history(H_dim, H_Guna, H_Kosha)

theta_dim, theta_Guna, theta_Kosha =
threshold_controller.compute_adaptive_thresholds()

stability, variances = threshold_controller.get_stability_assessment()

diagnostics\[\'adaptive_thresholds\'\] = {

\'theta_dim\': theta_dim,

\'theta_Guna\': theta_Guna,

\'theta_Kosha\': theta_Kosha,

\'stability\': stability,

\'variances\': variances

}

\# Enhancement 3: Convergence Tracking

state_dict = {

\'H_dim\': H_dim_norm, \'H_Guna\': H_Guna_norm, \'H_Kosha\':
H_Kosha_norm,

\'lambda_ctx\': lambda_ctx, \'lambda_res\': lambda_res,

\'structured_score\': structured_score, \'open_score\': open_score

}

converged, confidence_boost = convergence_tracker.update(state_dict)

if converged:

structured_score \*= (1.0 + confidence_boost)

diagnostics\[\'convergence\'\] = {

\'converged\': True,

\'boost\': confidence_boost,

\'stability_score\': convergence_tracker.get_stability_score()

}

\# \... (rest of decide_mode logic using adaptive thresholds) \...

\# ========== SECTION 5.3 IMPROVEMENTS ==========

\# Improvement 1: Mirror Logic for Deferred Insights

if deferred_insights and current_time:

ready_insights = \[\]

for insight in deferred_insights:

T_elapsed = current_time - insight\[\'timestamp\'\]

R = mirror_engine.compute_readiness(

insight\[\'H_dim\'\], insight\[\'H_Guna\'\], insight\[\'H_Kosha\'\],
T_elapsed

)

mode_delivery, transformed, reason = mirror_engine.decide_delivery_mode(

R, insight\[\'harm\'\], insight\[\'content\'\]

)

if mode_delivery != \'defer\':

ready_insights.append({

\'transformed\': transformed,

\'delivery_mode\': mode_delivery,

\'readiness\': R

})

diagnostics\[\'deferred_insights\'\] = ready_insights

\# Improvement 2: Beam Expansion

submode, beam_size, beam_diag = select_submode_with_beam_expansion(

mode, H_dim_norm, H_Guna_norm, confidence,

retrieval_enabled, retrieval_quality,

iteration, max_iterations

)

diagnostics.update(beam_diag)

\# Improvement 3: Distributed Sync (if applicable)

if sync_controller:

P_vritti_effective, aspect_weights_effective, source =
sync_controller.get_effective_params()

diagnostics\[\'distributed_sync\'\] = {\'param_source\': source}

return mode, submode, beam_size, diagnostics

