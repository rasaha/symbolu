{
  "name": "ugence-authority-plane",
  "version": "0.2.1",
  "private": true,
  "description": "Ugence Authority Plane — the administrators' surface for authority acts, over the governed runtime worker. ADR_UGENCE_AUTHORITY_PLANE_SCOPING.md: a read-only shell over the four AP-5 reads; no write until the identity adapter is validated against a real enterprise issuer (AP-3 controlling, section 18).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4200",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "verify:boundary": "node scripts/verify-boundary.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
