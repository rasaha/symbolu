                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Publish Shadow",
        "tags": [
          "publish"
        ]
      }
    },
    "/api/v2/simulate/run": {
      "post": {
        "description": "Drive a workflow a bounded number of quanta and report every outcome.\n\n``execution_mode`` accepts only the non-mutating modes; ``LIVE`` is refused with a\ntyped 422 rather than being silently downgraded, so a caller that asked for live\nexecution learns that the studio does not do that.",
        "operationId": "v2_simulate_run",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulateRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Simulation",
        "tags": [
          "simulate"
        ]
      }
    }
  }
}
