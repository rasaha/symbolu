{
  "components": {
    "schemas": {
      "ConstitutionPreflightRequest": {
        "additionalProperties": false,
        "description": "Dry-run every pre-signing check.\n\n``preflight_issuance`` is documented as mutation-free, which is exactly why it is\nthe only activation entry point the studio may reach (SD-2): it reports what\nissuance *would* find without performing it.",
        "properties": {
          "approval_reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Reference"
          },
          "constitution": {
            "additionalProperties": true,
            "title": "Constitution",
            "type": "object"
          },
          "expected_reference_tenant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Reference Tenant Id"
          },
          "record_id": {
            "title": "Record Id",
            "type": "string"
          }
        },
        "required": [
          "constitution",
          "record_id"
        ],
        "title": "ConstitutionPreflightRequest",
        "type": "object"
      },
      "ConstitutionValidateRequest": {
        "additionalProperties": false,
        "description": "Structural validation of a constitution document. Mutation-free.",
        "properties": {
          "constitution": {
            "additionalProperties": true,
            "title": "Constitution",
            "type": "object"
          }
        },
        "required": [
          "constitution"
        ],
        "title": "ConstitutionValidateRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PolicyCompileRequest": {
        "additionalProperties": false,
        "description": "Compile a reviewed pack.\n\n``approval`` is required and is never defaulted: the compiler's\n``require_approval`` defaults to True and the studio never overrides it.",
        "properties": {
          "approval": {
            "additionalProperties": true,
            "title": "Approval",
            "type": "object"
          },
          "pack": {
            "additionalProperties": true,
            "title": "Pack",
            "type": "object"
          }
        },
        "required": [
          "pack",
          "approval"
        ],
        "title": "PolicyCompileRequest",
        "type": "object"
      },
      "PolicyPackRequest": {
        "additionalProperties": false,
        "description": "A policy pack as authored on the canvas, carried as a JSON object.",
        "properties": {
          "pack": {
            "additionalProperties": true,
            "title": "Pack",
            "type": "object"
          }
        },
        "required": [
          "pack"
        ],
        "title": "PolicyPackRequest",
        "type": "object"
      },
      "PublishShadowRequest": {
        "additionalProperties": false,
        "description": "Hand a compiled release package to the console's SHADOW governed loop.\n\nThere is no non-shadow variant of this request, by construction.",
        "properties": {
          "compiled_package": {
            "additionalProperties": true,
            "title": "Compiled Package",
            "type": "object"
          },
          "scenario_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario Id"
          }
        },
        "required": [
          "compiled_package"
        ],
        "title": "PublishShadowRequest",
        "type": "object"
      },
      "ReviewDecisionRequest": {
        "additionalProperties": false,
        "description": "A human's decision on a parked proposal, relayed verbatim (HR-1).\n\n``decision`` is the human's word — GRANT or REJECT — and the studio forwards it as\ntyped. ``presented_approver`` is the approver reference the review service listed\nas eligible; the studio holds no identity of its own and proves none, which is why\nthe review service labels every decision ``PRESENTED_UNPROVEN``. ``justification``\nis required: a decision without one is not relayed.",
        "properties": {
          "approval_id": {
            "minLength": 1,
            "title": "Approval Id",
            "type": "string"
          },
          "decision": {
            "enum": [
              "GRANT",
              "REJECT"
            ],
            "title": "Decision",
            "type": "string"
          },
          "justification": {
            "minLength": 1,
            "title": "Justification",
            "type": "string"
          },
          "presented_approver": {
            "additionalProperties": true,
            "title": "Presented Approver",
            "type": "object"
          }
        },
        "required": [
          "approval_id",
          "decision",
          "presented_approver",
          "justification"
        ],
        "title": "ReviewDecisionRequest",
        "type": "object"
      },
      "SimulateRunRequest": {
        "additionalProperties": false,
        "description": "Run a workflow against fixtures, recording every governance decision.\n\n``execution_mode`` is constrained to the non-mutating modes. LIVE is not a member\nof the accepted set and cannot be requested.",
        "properties": {
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "execution_mode": {
            "default": "DRY_RUN",
            "title": "Execution Mode",
            "type": "string"
          },
          "max_quanta": {
            "default": 16,
            "title": "Max Quanta",
            "type": "integer"
          },
          "workflow": {
            "additionalProperties": true,
            "title": "Workflow",
            "type": "object"
          }
        },
        "required": [
          "workflow"
        ],
        "title": "SimulateRunRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Additive Governed Agent Studio surface over the Ugence governance packages. Thin orchestration only; synthetic and fixture data; planning and observation only. No route issues, activates, revokes, grants, authorizes, clears or executes.\n\n- API contract: governance_studio.api.v2\n- Frozen companion contract: governance_studio.api.v1 (unchanged)\n- Screens: Constitution, Policy, Authority, Simulate, Publish, Observe, Review",
    "summary": "Additive Governed Agent Studio surface over the Ugence governance packages. Thin orchestration only; synthetic and fixture data; planning and observation only. No route issues, activates, revokes, grants, authorizes, clears or executes.",
    "title": "Ugence Governed Agent Studio API v2",
    "version": "governance_studio.api.v2"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v2/authority/decisions/{decision_id}": {
      "get": {
        "description": "One recorded Decision Authority decision.",
        "operationId": "v2_authority_read_decision",
        "parameters": [
          {
            "in": "path",
            "name": "decision_id",
            "required": true,
            "schema": {
              "title": "Decision Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Decision",
        "tags": [
          "authority"
        ]
      }
    },
