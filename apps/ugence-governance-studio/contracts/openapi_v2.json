          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Validate Policy",
        "tags": [
          "policy"
        ]
      }
    },
    "/api/v2/publish/shadow": {
      "post": {
        "description": "Hand a compiled release package to the console's SHADOW governed loop.\n\nThere is no non-shadow variant. The console also exposes action-authorization and\nclearance routes; the studio's console client cannot reach them (SD-2).",
        "operationId": "v2_publish_shadow",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishShadowRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
