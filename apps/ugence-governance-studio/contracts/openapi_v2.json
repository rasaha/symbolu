    "/api/v2/review/decisions": {
      "post": {
        "description": "Relay a human's decision to the review service, verbatim.\n\nThe body is forwarded as received. The studio adds no identity, computes no\neligibility and reads nothing but the review service's typed answer, which it\nreturns whether the decision was recorded, replayed or refused.",
        "operationId": "v2_review_submit_decision",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewDecisionRequest"
              }
            }
          },
          "required": true
