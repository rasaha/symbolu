                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Synthesize Policy",
        "tags": [
          "policy"
        ]
      }
    },
    "/api/v2/policy/validate": {
      "post": {
        "description": "Validate a policy pack. No approval required; produces no release.",
        "operationId": "v2_policy_validate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyPackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
