{
  "name": "@ugence/governance-studio-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Ugence Governance Studio — planning explorer over the frozen governance_studio.api.v1 contract (P3C eligibility + P3D ranking, composition, permission proposals, fallbacks, replay, comparison and controlled what-if). Synthetic data; deterministic planning only; no authentication, deployment, permission granting, runtime provisioning or agent execution.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "node scripts/generate-api.mjs",
    "verify:openapi": "node scripts/verify-openapi.mjs",
    "verify:boundary": "node scripts/verify-boundary.mjs",
    "verify:terminology": "node scripts/verify-terminology.mjs",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "audit:dependencies": "node scripts/verify-dependency-audit.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.2",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vitest-axe": "^0.1.0"
  }
}
