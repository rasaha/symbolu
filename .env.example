# Symbol-U Environment Configuration
# Copy this to .env and fill in your values

# ===========================================
# LLM Provider API Keys
# ===========================================

# Anthropic Claude API Key (recommended for Symbol-U)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# Default LLM provider: "anthropic" or "google"
LLM_PROVIDER=anthropic

# ===========================================
# API Server Configuration
# ===========================================

# Server host and port
API_HOST=0.0.0.0
API_PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================================
# Token Usage Limits
# ===========================================

# Daily token limit per user (default: 50,000)
DAILY_TOKEN_LIMIT=50000

# ===========================================
# Security (Optional)
# ===========================================

# API key for authenticating requests (leave empty to disable)
SYMBOLU_API_KEY=

# Rate limit: requests per minute per IP
RATE_LIMIT_RPM=60

# ===========================================
# Alpaca Trading (MCP server)
# ===========================================
# Used by the "alpaca" MCP server defined in .mcp.json.
# Start in PAPER mode (PAPER=True). Only switch to live after you have
# forward-tested your strategy on paper for a meaningful period.
#
# Get keys from: https://app.alpaca.markets/paper/dashboard/overview
#   (Home page -> "Your API Keys" card -> "Generate New Key")
# Paper keys start with "PK"; live keys start with "AK".
#
# Note on variable names: the community alpaca-mcp-server reads
# ALPACA_API_KEY / ALPACA_SECRET_KEY, while alpaca-py and the REST
# API docs use APCA_API_KEY_ID / APCA_API_SECRET_KEY. We set both so
# that either consumer works without surprises.

ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=
PAPER=True

# SDK-compatible aliases (same values as above). Leave these even if
# you only use the MCP server — other tooling in the repo may read them.
APCA_API_KEY_ID=PK...
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Market data feed: "iex" (free) or "sip" (requires Algo Trader Plus sub)
ALPACA_DATA_FEED=iex
