{
  "$comment": "Immutable pilot deployment config (MVP 1E). Tightly bounded; fails closed; never inlines a credential value. Fingerprint excludes credential values.",
  "schema_version": "code_governance.pilot_deployment_config.v1",
  "max_concurrency": 4,
  "fields": [
    "config_id",
    "config_version",
    "pilot_id",
    "tenant_id",
    "allowed_repositories",
    "allowed_branches",
    "allowed_pull_request_numbers",
    "durable_store_path",
    "github_adapter_registry_ref",
    "credential_references",
    "approved_snapshot_adapters",
    "evaluation_profile_ref",
    "intervention_routing_ref",
    "reviewer_role_allowlist",
    "maximum_evaluations",
    "maximum_evaluations_per_hour",
    "maximum_concurrent_collections",
    "maximum_concurrent_evaluations",
    "collection_timeout_s",
    "retry_max_attempts",
    "pilot_start_at",
    "pilot_end_at",
    "manual_pause",
    "stop_thresholds",
    "retention_category",
    "logging_policy",
    "metrics_policy",
    "reporting_policy",
    "schema_version",
    "policy_refs"
  ],
  "rejected_when": [
    "empty repository allowlist",
    "wildcard tenant",
    "unrestricted repositories",
    "unrestricted branches",
    "write permission scope",
    "missing evaluation bound and pilot end",
    "unbounded concurrency",
    "missing durable store",
    "inline credentials",
    "unsupported schema version"
  ],
  "execution_status": "DISABLED"
}
