# DilChat mobile — local configuration example. Copy to `.env` (gitignored) and
# adjust. NO production endpoint is committed; the app reads DILCHAT_API_BASE_URL
# at build time via app.config.js -> extra.apiBaseUrl.
#
# Local backend (default when unset in development):
DILCHAT_API_BASE_URL=http://localhost:8080
# Android emulator reaching a host-machine backend uses:
# DILCHAT_API_BASE_URL=http://10.0.2.2:8080

# OPTIONAL — Expo push (Phase 3C, DILCHAT-D3C-M2). When unset, the app NEVER
# attempts push-token acquisition and runs on REST + polling alone. Set to the
# EAS project id of the deployment that owns the push credentials:
# DILCHAT_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
