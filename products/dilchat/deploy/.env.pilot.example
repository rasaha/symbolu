# Internal-pilot environment reference (round PR-C). Copy to `.env.pilot`,
# which is gitignored. NEVER commit real credentials; a real pilot supplies
# these from the platform's secret store rather than a file on disk.
#
#   docker compose --env-file .env.pilot -f deploy/docker-compose.pilot.yml up

# --- environment posture ------------------------------------------------------
# staging or production. Both enable the fail-fast guards (debug off, explicit
# postgresql+asyncpg DSN, https push URL, signing key required).
DILCHAT_ENVIRONMENT=staging

# --- database cluster ---------------------------------------------------------
POSTGRES_USER=dilchat_owner
POSTGRES_PASSWORD=change-me-not-a-real-secret
POSTGRES_DB=dilchat

# THREE DSNs, THREE ROLES. Role separation is the deployment's job: the web
# process is never handed the worker's credentials (DEC-3C-4 / I6).
#   owner  — migrations only (creates roles, tables, policies, definers)
#   app    — the web/API process (RLS-constrained, no outbox privileges)
#   worker — the relay only (claims/publishes/prunes outbox rows)
DILCHAT_OWNER_DATABASE_URL=postgresql+asyncpg://dilchat_owner:change-me@db:5432/dilchat
DILCHAT_APP_DATABASE_URL=postgresql+asyncpg://dilchat_app:change-me@db:5432/dilchat
DILCHAT_WORKER_DATABASE_URL=postgresql+asyncpg://dilchat_worker:change-me@db:5432/dilchat

# The dilchat_app / dilchat_worker roles are created NOLOGIN by the migrations
# (they are RLS postures, not accounts). Before first start, grant each a
# password and LOGIN as the owner:
#   ALTER ROLE dilchat_app    WITH LOGIN PASSWORD '…';
#   ALTER ROLE dilchat_worker WITH LOGIN PASSWORD '…';

# --- token signing ------------------------------------------------------------
# PEM of an EC P-256 private key. Required in staging/production — a missing key
# is a safe startup failure, never an ephemeral fallback.
DILCHAT_ACCESS_TOKEN_PRIVATE_KEY_PEM=

# --- astrology provider (DEC-029 / DEC-007) -----------------------------------
# "fake" is refused in staging/production. A real provider requires a recorded
# licensing decision or startup fails.
DILCHAT_ASTROLOGY_PROVIDER=swiss
DILCHAT_SWISS_PRODUCTION_LICENSED=false

# --- push (Phase 3C; optional) ------------------------------------------------
# "null" = the relay drains the outbox and sends nothing (safe pilot default).
# "expo" additionally requires the https Expo endpoint and pilot push credentials.
DILCHAT_PUSH_TRANSPORT=null

# --- web ----------------------------------------------------------------------
DILCHAT_WEB_PORT=8080
