# DilChat backend — environment variable reference (Phase A/B).
# Copy to `.env` for local development. NEVER commit a real `.env`.
# All variables are prefixed DILCHAT_.

# Environment: test | development | qa | staging | production
DILCHAT_ENVIRONMENT=development
DILCHAT_DEBUG=false
DILCHAT_API_V1_PREFIX=/v1

# Database (PostgreSQL via asyncpg in production; aiosqlite only for unit tests).
DILCHAT_DATABASE_URL=postgresql+asyncpg://postgres@/dilchat_dev?host=/tmp&port=5433

# Access-token signing (ES256). In development/test an ephemeral key is generated
# if unset. REQUIRED in staging/production (PEM of an EC P-256 private key).
# DILCHAT_ACCESS_TOKEN_PRIVATE_KEY_PEM=
# DILCHAT_ACCESS_TOKEN_PUBLIC_KEY_PEM=
DILCHAT_ACCESS_TOKEN_TTL_SECONDS=600
DILCHAT_REFRESH_TOKEN_TTL_SECONDS=2592000

# Astrology provider (DEC-029 policy). "fake" is a SYNTHETIC test/local-dev stub —
# it is refused in qa/staging/production. Production requires an approved real
# provider or startup fails (never a silent fake fallback).
#   test:        fake
#   development: fake | swiss
#   qa:          swiss (fake only with DILCHAT_ALLOW_FAKE_IN_QA=true)
#   staging/prod: swiss with DILCHAT_SWISS_PRODUCTION_LICENSED=true
DILCHAT_ASTROLOGY_PROVIDER=fake
# Swiss Ephemeris (AGPL dev edition) — see the licensing notice in README.md.
DILCHAT_ENABLE_SWISS_EPHEMERIS=false
# swieph (needs .se1 files; fails explicitly if absent) | moshier (analytical)
DILCHAT_SWISS_EPHEMERIS_MODE=moshier
# DILCHAT_SWISS_EPHEMERIS_PATH=/path/to/ephe
# Recorded approval of a compatible Swiss production-licensing decision
# (Professional License or accepted AGPL compliance). Required for staging/prod.
DILCHAT_SWISS_PRODUCTION_LICENSED=false
# Explicit opt-in to permit the synthetic fake provider in internal QA only.
DILCHAT_ALLOW_FAKE_IN_QA=false

# --- RLS runtime roles (production) ------------------------------------------
# In production the app connects as the non-owner role dilchat_app (worker:
# dilchat_worker); migrations run as the owner role. RLS context is set per
# transaction (SET LOCAL) from the authenticated JWT. See the hardening report.

# --- Chat safety (Phase 3B, DEC-3B) ------------------------------------------
# Ratified operational defaults; override only with owner sign-off.
# DILCHAT_RATELIMIT_SEND_PER_MINUTE=30
# DILCHAT_RATELIMIT_SEND_PER_HOUR=300
# DILCHAT_RATELIMIT_REPORT_PER_DAY=10
# DILCHAT_RATELIMIT_BLOCK_MUTATIONS_PER_HOUR=60
# DILCHAT_CHAT_REPORT_AFTER_REVOCATION_DAYS=30
# Destructive retention purge stays OFF until the D-PR-3 gates pass (tests,
# preservation proofs, legal review, dry-run evidence). Do not enable casually.
DILCHAT_RETENTION_PURGE_ENABLED=false

# --- Outbox relay / push (Phase 3C, DEC-3C) ----------------------------------
# The relay is a SEPARATE process: `python -m ugence_dilchat.relay`, connecting
# as dilchat_worker. Push is advisory; "null" transport is the safe default.
# DILCHAT_PUSH_TRANSPORT=null            # null | expo (pilot transport, D3C-1)
# DILCHAT_EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send   # must be https in staging/prod
# DILCHAT_RELAY_BATCH_SIZE=50
# DILCHAT_RELAY_POLL_INTERVAL_SECONDS=2.0
# DILCHAT_RELAY_MAX_ATTEMPTS=8
# DILCHAT_OUTBOX_PRUNE_AFTER_DAYS=30
# Purge ELIGIBILITY window (DEC-PR-3): a revoked conversation is retained at
# least this long after revocation. Must be >= the reporting window above, or
# startup fails. Eligibility is never automatic deletion — no destructive purge
# is implemented; `python -m ugence_dilchat.scripts_retention_report` is a
# read-only dry run.
# DILCHAT_CHAT_RETENTION_REVOKED_DAYS=30

# --- Relay liveness (round PR-C) ---------------------------------------------
# The relay serves no HTTP surface; when set it rewrites this file with an ISO
# timestamp each loop so a container healthcheck can assert freshness via
# `python -m ugence_dilchat.scripts_relay_health`. Unset = no heartbeat.
# DILCHAT_RELAY_HEARTBEAT_PATH=/var/run/dilchat/relay.heartbeat
# Must exceed DILCHAT_RELAY_POLL_INTERVAL_SECONDS or a healthy idle relay would
# look unhealthy; startup refuses a configuration where it does not.
# DILCHAT_RELAY_HEARTBEAT_MAX_AGE_SECONDS=120
