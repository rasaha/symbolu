  "info": {
    "description": "DilChat backend foundation (Ugence Labs): identity, birth profiles, deterministic natal-Moon derivation, three-scope authorization, and couple/consent/audit primitives. No user-facing Guna Milan, AI, daily transits, chat, or agreements are exposed in this phase.",
    "title": "DilChat Backend (Phase A/B)",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
