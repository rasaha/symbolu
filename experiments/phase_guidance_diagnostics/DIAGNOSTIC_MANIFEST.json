{
  "name": "phase_guidance_diagnostics",
  "purpose": "Localize why Phase-guided bounded slots (arm D) degrade vs plain slots (arm C); diagnostic only, frozen Phase unmodified.",
  "frozen_contract": {
    "modifies_frozen_phase": false,
    "frozen_package": "symbolu.lightweight_phase",
    "verifier": "python -m symbolu.lightweight_phase.freeze -> FREEZE OK",
    "tests": "98/98",
    "no_quadratic_attention_added": true
  },
  "reproduce": [
    "PYTHONPATH=. python3 -m experiments.phase_guidance_diagnostics.train_ckpts",
    "PYTHONPATH=. python3 -m experiments.phase_guidance_diagnostics.run_all"
  ],
  "layers": {
    "L1_tokens_to_phase_state": ["topic_probe", "distance_probe", "dilution_probe", "decay_probe"],
    "L2_phase_state_to_guidance": ["topic_probe", "guidance_probe", "head_analysis"],
    "L3_guidance_to_slot_decisions": ["score_decomposition", "slot_chain_trace", "multitask_interference"],
    "L4_slots_to_answer": ["shortcut_checks", "slot_chain_trace"]
  },
  "questions_to_scripts": {
    "A_topic_retained": "topic_probe.py",
    "B_signal_decays_with_distance": "distance_probe.py",
    "C_cumulative_normalization_dilution": "dilution_probe.py",
    "D_learned_decay_removes_topic": "decay_probe.py",
    "E_head_specialization": "head_analysis.py",
    "F_guidance_head_extraction": "guidance_probe.py",
    "G_write_label_alignment": "PHASE_GUIDANCE_ROOT_CAUSE_REPORT.md (analytic + dataset stats)",
    "H_phase_overpowers_content_addressing": "score_decomposition.py",
    "I_write_vs_retention_vs_eviction_vs_read": "slot_chain_trace.py + arm ablations (D-write-only/D-query-only)",
    "J_task_slot_pressure_validity": "slot_chain_trace.py",
    "K_query_time_shortcut": "shortcut_checks.py",
    "L_multitask_interference": "multitask_interference.py",
    "M_broad_write_dilution": "dilution_probe.py + decay_probe.py (masking interpretation)"
  },
  "arms": {
    "A": "local only (no slots)",
    "C": "local + slots, guidance from h only (no Phase)",
    "D": "local + slots, guidance from [h; Phase g]",
    "D-no-guid": "Phase computed, guidance zeroed",
    "D-write-only": "Phase guidance on writes only",
    "D-query-only": "Phase guidance on reads only"
  },
  "phase_config_hash": "d9ba8c6bde3d6773c180d792fbcac045d4f1250b08e6de6c3e797344711d4e3b",
  "artifacts": {
    "baseline": "baseline.json",
    "raw_per_probe": "results/raw/*.json",
    "checkpoints": "results/ckpt/*.pt (+ .json metrics)",
    "aggregate": "results/aggregate.json",
    "tables": "results/tables.md",
    "report": "PHASE_GUIDANCE_ROOT_CAUSE_REPORT.md"
  }
}
