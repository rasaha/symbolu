# First admission study (RM-4) — run-environment template. RESEARCH ONLY.
#
# Copy to a `.env` OUTSIDE the repository, or set these in the Claude Code on the web
# environment settings (Environments -> environment variables). `.env` is git-ignored at
# the repository root; the prepared-bundle credential scan refuses any bundle that carries
# a credential-shaped value. Never paste a key into chat, a commit, or a manifest.

# Model provider credential, read only inside the boundary process by the provider
# factory. Set exactly the one matching the preregistered model client identity.
MISTRAL_API_KEY=
# OPENAI_API_KEY=

# Benchmark file, outside the repository (the sampler never opens it; the loader reads it
# at run time and commits digests only).
WORKFLOW_FIT_BENCHMARK_PATH=~/datasets/big-bench-hard/bbh/logical_deduction_seven_objects.json
