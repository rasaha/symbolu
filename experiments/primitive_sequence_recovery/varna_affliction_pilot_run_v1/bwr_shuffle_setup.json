{
 "seed": "BWR_SHUFFLE_1",
 "shuffle_map": {
  "k": "tṛṣṇā — limitless thirst to acquire: unquenchable craving for wealth, name, fame, power and prestige (not thirst for water)",
  "kh": "viśāda — melancholy, dejection that sinks one's own mood; gloom, the sinking of spirits",
  "g": "praśraya / praṇāśa — giving latitude to the point of dissolution; unrestrained indulgence that runs to annihilating collapse",
  "gh": "kruratā — cruelty: physical harm inflicted on the weak; crude, cruel thought and behaviour",
  "ṅ": "viveka distorted — discernment hardening into judgmentalism / separation-pride (discrimination used to feel superior to others)",
  "c": "ghṛṇā — the fetter of hatred / revulsion: hatred arising (mainly from frustrated moha) and the downward pull toward the crude (pat / patati -> downfall)",
  "ch": "mūrcchā — hypnotic entrancement, the loss of common sense / discernment under the spell of a ripu (deluded obsession that suspends judgment)",
  "j": "collapse of mental function under strain — the mind that had functioned properly begins to malfunction or stops altogether",
  "jh": "outward / visible vision — fixation on the manifest, physically-seen, outward-facing world",
  "ñ": "bhaya — fear: collapse or flight before danger; the shrinking, dread and panic under threat",
  "ṭ": "āśā as grasping / clinging hope — goaded toward a specific outcome or object; the downward pull of attached desire",
  "ṭh": "aviśvāsa — self-doubt that cannot commit: lack of confidence and wavering ('shall I be able to do it?'), distrust of self and others",
  "ḍ": "vitarka — overstating one's case to the point of garrulousness; bad-tempered, exaggerated over-talk beyond what is warranted (the abusive over-response)",
  "ḍh": "lajjā as inhibition — action held back by others' regard; shrinking, self-conscious shame that blocks natural conduct",
  "ṇ": "artha as possessive acquisition — worldly purpose pursued and possessed as acquisition, status or control (rajasic grasping to acquire)",
  "t": "ensconcement gone rigid — over-holding, clinging to one's holding; stuck fixity that resists the movement toward subtlety",
  "th": "cintā as anxious rumination — the mind churning over unresolved contingencies and personal consequences (e.g. worrying through the late-train inconveniences), gripping the what-ifs",
  "d": "the inflated 'I did / I control this' — the 'I'-feeling swollen into sole doership (as in Aurangzeb: 'had I not been there the world would have been destroyed')",
  "dh": "hypocrisy / concealment — inner and outer diverging: cheating to serve one's purpose, domineering to hide one's own weakness, condemning in others the sins one secretly commits",
  "n": "jāḍya — inertia, staticity, dullness, torpor: the deep sleep of mind, intellectual dullness and spiritual inertness",
  "p": "greed / avarice — hoarding accumulation without limit; the insatiable greedy fascination (nolā) that always wants more",
  "ph": "moha — blind attachment / infatuation: the mind fixated on an object, place, time or idea, losing rationality (geo-sentiment; nostalgia for an age; the thief drawn back to the scene; fascination for a battered object)",
  "b": "sarvanāśa — the defeatist annihilation-thought ('I have nothing, everything is gone, I am undone'); destructive collapse, the sense of total defeat",
  "bh": "envy — the sting at another's success; covetous resentment at another's good fortune",
  "m": "mamatā bounded by the relative factors (time, space, individuality) — partial, possessive 'mine-ness' that clings to its own (own child, own country, own moment) while excluding or even harming what lies outside it",
  "y": "restless striving that cannot stop — effort compulsively driven on, unable to cease (and, clung to mundane ends, ceaseless outward striving)",
  "r": "avajñā — neglect / disregard of what actually has value; indifference misapplied so that genuine worth goes unattended",
  "l": "dambha as vanity — the self displayed and performed for others' eyes; conduct staged to be seen and admired",
  "v": "kāma — worldly / physical desire and longing: grasping for wealth, opulence, name, fame, social position; the tamasic pull toward the crude",
  "ś": "anutāpa as gripping remorse — the 'after-heat' that torments, replaying one's own past wrong without release",
  "ṣ": "the sentient / sattvic impulse clung to — clarity, purity or harmony owned as superiority or attachment (the subtle 'golden chain' of spiritual attainment)",
  "s": "peevishness / reactive irritability — perverse, contrary reactivity discharged at others (taking offence at kindness, calm under harshness)",
  "h": "piśunatā — senseless, sadistic cruelty: harming/killing with gratuitous torture (dismembering a creature piece by piece; impaling, flaying), inflicting maximal suffering for its own sake; malice toward the maligned"
 },
