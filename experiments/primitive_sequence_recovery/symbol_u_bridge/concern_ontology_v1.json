        "low, mournful affect"
      ],
      "exclusion_criteria": [
        "fear of a future loss (see fear)"
      ],
      "parent": "attachment_and_loss",
      "children": [],
      "synonyms": [
        "grief",
        "sorrow",
        "mourning",
        "heartbroken"
      ]
    },
    {
      "id": "C0007",
      "label": "craving",
      "description": "Wanting to obtain or experience something one does not yet have.",
