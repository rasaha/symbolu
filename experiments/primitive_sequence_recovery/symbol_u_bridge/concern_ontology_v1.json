{
  "schema_version": "concern_ontology_v1",
  "ontology_sha256": "39de5d4d2f0252634948b4f15e6486494094479dfe013131aa17807207cfe168",
  "concerns": [
    {
      "id": "C0001",
      "label": "fear",
      "description": "An aversive anticipatory reaction to a perceived threat or danger.",
      "inclusion_criteria": [
        "speaker anticipates harm/danger",
        "emotional charge is dread/alarm"
      ],
      "exclusion_criteria": [
        "general low mood without a threat (see grief)",
        "doubt about a decision (see doubt)"
      ],
      "parent": "fear_and_insecurity",
      "children": [],
      "synonyms": [
        "afraid",
        "scared",
        "terrified",
        "frightened"
      ]
    },
    {
      "id": "C0002",
      "label": "anxiety",
      "description": "Sustained worried thought about an uncertain or future situation.",
      "inclusion_criteria": [
        "worry is diffuse / about the future",
        "rumination present"
      ],
      "exclusion_criteria": [
        "acute fear of a present threat (see fear)"
      ],
      "parent": "fear_and_insecurity",
      "children": [],
      "synonyms": [
        "worried",
        "anxious",
        "nervous",
        "apprehensive"
      ]
    },
    {
      "id": "C0003",
      "label": "anger",
      "description": "A hostile emotional reaction to a perceived wrong or obstruction.",
      "inclusion_criteria": [
        "hostile arousal toward a target",
        "triggered by a wrong/blockage"
      ],
      "exclusion_criteria": [
        "settled dislike without arousal (see resentment)"
      ],
      "parent": "anger_and_conflict",
      "children": [],
      "synonyms": [
        "angry",
        "furious",
        "mad",
        "enraged"
      ]
    },
    {
      "id": "C0004",
      "label": "resentment",
      "description": "A settled aversion or ill-will held toward someone or something.",
      "inclusion_criteria": [
        "persistent dislike/ill-will",
        "cold rather than hot"
      ],
      "exclusion_criteria": [
        "momentary anger (see anger)"
      ],
      "parent": "anger_and_conflict",
      "children": [],
      "synonyms": [
        "resentful",
        "bitter",
        "aversion",
        "grudge"
      ]
    },
    {
      "id": "C0005",
      "label": "attachment",
      "description": "Clinging to a person, object, or outcome as needed for one's wellbeing.",
      "inclusion_criteria": [
        "felt need to hold on / not lose",
        "identification with the object"
      ],
      "exclusion_criteria": [
        "simple wanting of something not yet had (see craving)"
      ],
      "parent": "attachment_and_loss",
      "children": [],
      "synonyms": [
        "clinging",
        "attached",
        "holding on",
        "can't let go"
      ]
    },
    {
