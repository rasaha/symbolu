        "pull toward acquiring/experiencing",
        "object not yet possessed"
      ],
      "exclusion_criteria": [
        "holding on to what one has (see attachment)",
        "hoarding more than needed (see greed)"
      ],
      "parent": "desire_and_ambition",
      "children": [],
      "synonyms": [
        "craving",
        "longing",
        "wanting",
        "desire"
      ]
    },
