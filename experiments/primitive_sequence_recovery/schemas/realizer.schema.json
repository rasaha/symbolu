{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "psr.realizer.schema.json",
  "title": "realizer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "realizer_id", "status", "deterministic",
               "offline_only", "execution_allowed", "implementation_present",
               "primary_realizer_type", "robustness_realizers",
               "expected_input", "expected_output", "similarity_metric",
               "normalization", "model_asset", "model_sha256",
               "concept_resolver", "concept_resolver_status", "notes"],
  "properties": {
    "schema_version": { "type": "string" },
    "realizer_id": { "type": "string" },
    "status": { "enum": ["NOT_IMPLEMENTED", "IMPLEMENTED"] },
    "deterministic": { "type": "boolean" },
    "offline_only": { "type": "boolean" },
    "execution_allowed": { "type": "boolean" },
    "implementation_present": { "type": "boolean" },
    "primary_realizer_type": { "type": "string" },
    "robustness_realizers": { "type": "array", "items": { "type": "string" } },
    "expected_input": { "type": "string" },
    "expected_output": { "type": "string" },
    "similarity_metric": { "type": "string" },
    "normalization": { "type": "string" },
    "model_asset": { "type": ["string", "null"] },
    "model_sha256": { "type": ["string", "null"] },
    "concept_resolver": { "type": ["string", "null"] },
    "concept_resolver_status": { "enum": ["NOT_IMPLEMENTED", "IMPLEMENTED"] },
    "notes": { "type": "string" }
  }
}
