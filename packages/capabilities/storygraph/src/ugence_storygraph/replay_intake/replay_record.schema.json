{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugence.ai/ctd/replay_record.schema.json",
  "title": "Sanitized Account-Takeover Replay Record",
  "description": "One sanitized historical record for the account-takeover replay (§5, §13). Entity fields MUST be redaction tokens, never raw identifiers. record_kind selects which optional fields apply.",
  "type": "object",
  "required": ["tenant", "source_system", "source_event_id", "record_kind", "canonical_event_type", "event_time", "ingestion_time", "source_ordering", "workflow_id"],
  "properties": {
    "tenant": {"type": "string", "description": "opaque tenant token (mandatory; no cross-tenant mixing)"},
    "source_system": {"type": "string"},
    "source_event_id": {"type": "string"},
    "record_kind": {"enum": ["event", "proposal", "approval", "provider_availability", "identity_snapshot", "execution_receipt"]},
    "canonical_event_type": {"enum": ["CREDENTIAL_RESET", "DEVICE_ENROLLMENT", "BENEFICIARY_ADD", "LIMIT_INCREASE", "TRANSFER", "APPROVAL", "PROVIDER_AVAILABILITY", "IDENTITY_SNAPSHOT", "EXECUTION_RECEIPT"]},
    "event_time": {"type": "string", "description": "trusted source event time (RFC3339)"},
    "ingestion_time": {"type": "string"},
    "source_ordering": {"type": "integer", "description": "trusted source sequence if available"},
    "workflow_id": {"type": "string", "description": "correlation / case id grouping one candidate workflow"},
    "actor": {"type": "string", "description": "redaction token"},
    "account": {"type": "string", "description": "redaction token"},
    "device": {"type": "string", "description": "redaction token"},
    "beneficiary": {"type": "string", "description": "redaction token"},
    "destination": {"type": "string", "description": "redaction token"},
    "amount": {"type": ["string", "number"]},
    "currency": {"type": "string"},
    "dedup_identity": {"type": "string"},
    "payload_digest": {"type": "string"},
    "redaction_status": {"enum": ["OK", "PARTIAL", "FAILED"]},
    "data_quality_status": {"enum": ["OK", "SUSPECT", "QUARANTINE"]},
    "pre_action_evaluation": {"type": "boolean", "description": "proposal only: true if the record establishes what was known BEFORE execution; false => POST_HOC_ONLY"},
    "already_executed": {"type": "boolean"},
    "tag": {"type": "string", "description": "approval only: trusted authorization tag"},
    "valid": {"type": "boolean", "description": "approval only: verified by a trusted provider"},
    "covered_operations": {"type": "array", "items": {"type": "string"}},
    "amount_cap": {"type": ["number", "null"]},
    "expires_at": {"type": ["number", "string", "null"]},
    "state": {"enum": ["AVAILABLE", "UNAVAILABLE", "STALE", "CONFLICTING"], "description": "provider_availability only"}
  }
}
