{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugence.ai/schemas/hiring/hiring_reconciliation_record.schema.json",
  "title": "HiringReconciliationRecord",
  "description": "Closes the governance loop, mirroring the platform Reconciliation pattern. Links a decision's PREDICTED dimension compatibility to ACTUAL outcomes observed at 1/3/6/12 months (incl. the 90-day trajectory), and yields a governed calibration proposal that RECOMPILES the policy into a new contract version. Never tunes hidden model weights; never edits history. Answers: why hired, did the prediction hold, which evidence was wrong, which dimension failed, should the policy/weight/gate change.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "candidate_id", "role_id", "decision_id", "execution_receipt_id", "contract_ref", "checkpoint", "predicted_vs_actual", "questions_answered"],
  "properties": {
    "record_id": { "type": "string" },
    "candidate_id": { "type": "string" },
    "role_id": { "type": "string" },
    "decision_id": { "type": "string" },
    "execution_receipt_id": { "type": "string" },
    "source_recommendation_id": { "type": "string" },
    "contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "version", "ir_digest"],
      "properties": {
        "contract_id": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "ir_digest": { "type": "string" }
      }
    },
    "checkpoint": { "type": "string", "enum": ["ONE_MONTH", "THREE_MONTH", "SIX_MONTH", "TWELVE_MONTH"] },
    "trajectory": {
      "type": "string",
      "enum": ["ON_TRACK", "OUTPERFORMING", "UNDERPERFORMING", "AT_RISK", "EXITED"],
      "description": "Rollup trajectory (90-day and beyond)."
    },
    "predicted_vs_actual": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "predicted", "actual", "outcome_evidence"],
        "properties": {
          "dimension": { "type": "string" },
          "predicted": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "actual": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "delta": { "type": ["number", "null"], "description": "actual - predicted." },
          "verdict": { "type": "string", "enum": ["HELD", "OVER_PREDICTED", "UNDER_PREDICTED"] },
          "outcome_evidence": {
            "type": "array",
            "items": { "type": "string", "enum": ["ONBOARDING", "MANAGER_REVIEW", "PERFORMANCE_GOAL", "COLLABORATION", "DELIVERY", "RETENTION"] }
          }
        }
      }
    },
    "questions_answered": {
      "type": "object",
      "additionalProperties": false,
      "description": "The closed-loop governance questions this record makes answerable.",
      "properties": {
        "why_hired": { "type": "string", "description": "Reason tree / recommendation ref." },
        "did_prediction_hold": { "type": "boolean" },
        "which_evidence_was_wrong": { "type": "array", "items": { "type": "string" } },
        "which_dimension_failed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "calibration_proposal": {
      "type": "object",
      "additionalProperties": false,
      "description": "Governed proposal to recompile the policy. Applies to the NEXT contract version only.",
      "properties": {
        "targets": { "type": "array", "items": { "type": "string", "enum": ["DIMENSION_WEIGHTS", "CONFIDENCE_THRESHOLDS", "EVIDENCE_REQUIREMENTS", "MANDATORY_GATES", "ACTION_CONSTRAINTS"] } },
        "rationale": { "type": "string" },
        "recompile_policy_id": { "type": "string" },
        "proposed_ir_version": { "type": "string" },
        "status": { "type": "string", "enum": ["PROPOSED", "IN_REVIEW", "APPROVED", "RECOMPILED", "REJECTED"], "default": "PROPOSED" }
      }
    }
  }
}
