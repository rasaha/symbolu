{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugence.ai/schemas/hiring/hiring_decision_contract.schema.json",
  "title": "HiringDecisionContract",
  "description": "The versioned, deployable policy object the Decision Authority evaluates for a role — projected from ONE signed HiringWorkflowIR digest (see hiring_workflow_ir.schema.json), which the Hiring Policy Compiler (PWC) produced from a declarative Hiring Policy. The Decision Authority evaluates THIS over (dimension evidence, mandatory gates, confidence) — never a fit score. The Overall Fit Index never enters here; it is analytics-only. The compiler rejects any policy that references the OFI in a gate/eligibility/action rule, makes a mandatory gate compensable, omits required evidence for a weighted dimension, admits an AI principal into the approval chain, or declares action constraints beyond approver authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "version",
    "status",
    "role_ref",
    "compiled_from",
    "mandatory_gates",
    "dimension_weights_ref",
    "evidence_requirements",
    "confidence_thresholds",
    "action_constraints",
    "runtime_assurance_checks",
    "review_schedule",
    "approval_chain",
    "compilation"
  ],
  "properties": {
    "contract_id": { "type": "string" },
    "version": { "type": "integer", "minimum": 1, "description": "Immutable once PUBLISHED." },
    "status": { "type": "string", "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "PUBLISHED", "DEPRECATED"] },
    "role_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_definition_id"],
      "properties": {
        "job_definition_id": { "type": "string" }
      }
    },
    "compiled_from": {
      "type": "object",
      "additionalProperties": false,
      "description": "Provenance: the signed IR digest this contract projects. Makes the contract reproducible and tamper-evident.",
      "required": ["source_policy_id", "ir_digest", "ir_version", "signature"],
      "properties": {
        "source_policy_id": { "type": "string" },
        "ir_digest": { "type": "string" },
        "ir_version": { "const": "hiring_workflow_ir.v1" },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["alg", "key_id", "value"],
          "properties": {
            "alg": { "type": "string" },
            "key_id": { "type": "string" },
            "value": { "type": "string" }
          }
        }
      }
    },
    "action_constraints": {
      "type": "object",
      "additionalProperties": false,
      "description": "Approved bounds an offer/action must satisfy; enforced by the Hiring ActionGate (deviation => DENY_REAUTH).",
      "required": ["salary_ceiling", "approved_level"],
      "properties": {
        "salary_ceiling": { "type": "number", "minimum": 0 },
        "salary_currency": { "type": "string", "default": "USD" },
        "approved_level": { "type": "string" },
        "approved_roles": { "type": "array", "items": { "type": "string" } },
        "allowed_locations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "runtime_assurance_checks": {
      "type": "array",
      "items": { "type": "string", "enum": ["APPROVALS_VALID", "REFERENCES_COMPLETE", "BACKGROUND_CHECK_CURRENT", "OFFER_NOT_EXPIRED", "SALARY_POLICY_SATISFIED", "REQUISITION_OPEN"] },
      "description": "Checks Runtime Assurance must pass before the HRIS/ATS write."
    },
    "mandatory_gates": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "mandatory_gate.schema.json" },
      "description": "Non-compensatory gates evaluated for eligibility."
    },
    "dimension_weights_ref": {
      "type": "string",
      "description": "Reference to the RCP dimension weights (advisory OFI only)."
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "required_types"],
        "properties": {
          "dimension": { "type": "string" },
          "required_types": { "type": "array", "items": { "type": "string" } },
          "admissibility_policy": { "type": "string", "description": "TAP admissibility policy id applied to this dimension's evidence." }
        }
      }
    },
    "confidence_thresholds": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 },
      "description": "Per-dimension minimum confidence (emitted by the compiler into the IR)."
    },
    "review_schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoints_months"],
      "properties": {
        "checkpoints_months": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "default": [1, 3, 6, 12],
          "description": "Post-hire review cadence feeding calibration."
        }
      }
    },
    "approval_chain": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered human approver roles authorized to turn a recommendation into a binding decision. AI principals are rejected at compile time.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approver_role", "actor_type"],
        "properties": {
          "approver_role": { "type": "string" },
          "actor_type": { "const": "HUMAN" }
        }
      }
    },
    "compilation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiled", "checks"],
      "properties": {
        "compiled": { "type": "boolean" },
        "compiler_version": { "type": "string" },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "no_ofi_in_policy": { "type": "boolean", "description": "true = the OFI is analytics-only and appears in no gate/eligibility/action rule." },
            "gates_non_compensatory": { "type": "boolean" },
            "weighted_dimensions_have_required_evidence": { "type": "boolean" },
            "approval_chain_human_only": { "type": "boolean" },
            "action_constraints_within_approver_authority": { "type": "boolean" },
            "constrained_actions_have_assurance_checks": { "type": "boolean" }
          }
        }
      }
    }
  }
}
