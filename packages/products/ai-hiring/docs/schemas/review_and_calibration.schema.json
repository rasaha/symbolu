{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugence.ai/schemas/hiring/review_and_calibration.schema.json",
  "title": "ReviewAndCalibration",
  "description": "Closed-loop learning artifacts. Every hiring decision is a prediction measured against observed post-hire outcomes at 1/3/6/12 months. Calibration improves explicit, versioned RCP/HDC artifacts via the governed author->approve->publish path; it NEVER tunes hidden neural weights and NEVER edits a past recommendation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "candidate_id", "role_id", "source_recommendation_id", "checkpoint", "observations"],
  "properties": {
    "record_id": { "type": "string" },
    "candidate_id": { "type": "string" },
    "role_id": { "type": "string" },
    "source_recommendation_id": { "type": "string", "description": "The at-hire recommendation whose predictions this review measures." },
    "checkpoint": {
      "type": "string",
      "enum": ["ONE_MONTH", "THREE_MONTH", "SIX_MONTH", "TWELVE_MONTH"]
    },
    "observations": {
      "type": "array",
      "description": "Observed vs predicted per dimension.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "predicted", "observed", "evidence_types"],
        "properties": {
          "dimension": { "type": "string" },
          "predicted": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "observed": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "delta": { "type": ["number", "null"], "description": "observed - predicted (computed)." },
          "evidence_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["ONBOARDING", "MANAGER_REVIEW", "PERFORMANCE_GOAL", "COLLABORATION", "DELIVERY", "RETENTION"]
            },
            "description": "Post-hire evidence. No psychological inference."
          }
        }
      }
    },
    "calibration_proposal": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional: proposed change to the NEXT contract version. Never mutates the current published RCP/HDC or any past recommendation.",
      "properties": {
        "targets": {
          "type": "array",
          "items": { "type": "string", "enum": ["RCP_WEIGHTS", "CONFIDENCE_THRESHOLDS", "EVIDENCE_REQUIREMENTS", "GATE_DEFINITIONS"] }
        },
        "rationale": { "type": "string" },
        "proposed_rcp_version": { "type": "integer", "minimum": 2 },
        "proposed_contract_version": { "type": "integer", "minimum": 2 },
        "status": { "type": "string", "enum": ["PROPOSED", "IN_REVIEW", "APPROVED", "PUBLISHED", "REJECTED"] }
      }
    }
  }
}
