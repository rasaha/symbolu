{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugence.ai/schemas/hiring/hiring_calibration_report.schema.json",
  "title": "HiringCalibrationReport",
  "description": "Cohort-level post-hire calibration report. Aggregates completed hires by role/policy version, decision-contract version, dimension, review horizon, and confidence band, and reports prediction-vs-observed deltas, over/underprediction, missing-evidence patterns, dimension reliability by horizon, and optional descriptive retention and Overall-Fit summaries. Descriptive only — it changes nothing. Overall Fit here is analytics-only and never a policy input. The cohort key is governance-scoped (role/policy/contract) and carries no candidate demographics, so calibration data cannot proxy a protected attribute. Tracks ugence_ai_hiring.hiring_calibration.report.HiringCalibrationReport.",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id", "cohort_key", "case_ids"],
  "$defs": {
    "checkpoint": { "type": "string", "enum": ["ONE_MONTH", "THREE_MONTH", "SIX_MONTH", "TWELVE_MONTH"] },
    "band": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] }
  },
  "properties": {
    "report_id": { "type": "string" },
    "cohort_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "policy_id", "contract_id", "contract_version", "ir_digest"],
      "properties": {
        "role_id": { "type": "string" },
        "policy_id": { "type": "string" },
        "contract_id": { "type": "string" },
        "contract_version": { "type": "integer", "minimum": 1 },
        "ir_digest": { "type": "string" }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "case_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "receipt_ids": { "type": "array", "items": { "type": "string" } },
    "review_ids": { "type": "array", "items": { "type": "string" } },
    "deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "horizon", "confidence_band", "direction"],
        "properties": {
          "dimension": { "type": "string" },
          "horizon": { "$ref": "#/$defs/checkpoint" },
          "confidence_band": { "$ref": "#/$defs/band" },
          "predicted_mean": { "type": ["number", "null"] },
          "observed_mean": { "type": ["number", "null"] },
          "delta": { "type": ["number", "null"], "description": "observed_mean - predicted_mean (calibration error)." },
          "direction": { "type": "string", "enum": ["ACCURATE", "OVERPREDICTION", "UNDERPREDICTION", "INSUFFICIENT"] },
          "sample_size": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "reliability": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "horizon"],
        "properties": {
          "dimension": { "type": "string" },
          "horizon": { "$ref": "#/$defs/checkpoint" },
          "mean_abs_delta": { "type": ["number", "null"] },
          "reliability": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "sample_size": { "type": "integer", "minimum": 0 },
          "missing_evidence_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "missing_evidence": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "retention_summary": { "type": ["object", "null"], "description": "Optional descriptive retention/performance outcomes where supplied." },
    "overall_fit_descriptive": { "type": ["object", "null"], "description": "Optional analytics-only Overall Fit summary; never a policy input." }
  }
}
