{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugence.ai/schemas/hiring/hiring_workflow_ir.schema.json",
  "title": "HiringWorkflowIR",
  "description": "The canonical, typed compiled artifact produced by the Hiring Policy Compiler (PWC) from a Hiring Policy. Mirrors the platform WorkflowIR (workflow_ir.v1): normalized, versioned, content-addressed (digest over canonical form) and signed. Recompiling the same policy yields the same digest. A Hiring Decision Contract is a deployable projection of one IR digest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ir_kind", "ir_version", "source_policy_id", "content_digest", "signature", "dimensions", "dimension_weights", "mandatory_gates", "evidence_requirements", "confidence_thresholds", "action_constraints", "runtime_assurance_checks", "approval_chain", "review_schedule_months", "compiler"],
  "properties": {
    "ir_kind": { "const": "hiring_workflow_ir" },
    "ir_version": { "const": "hiring_workflow_ir.v1" },
    "source_policy_id": { "type": "string" },
    "content_digest": { "type": "string", "description": "Content address (e.g. sha256) over the canonical IR form. Reproducible: same policy -> same digest." },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id", "value"],
      "properties": {
        "alg": { "type": "string", "examples": ["ed25519"] },
        "key_id": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "examples": ["TECHNICAL", "LEADERSHIP", "DOMAIN", "BEHAVIOR", "LEARNING", "OPERATING_ENVIRONMENT_COMPATIBILITY", "ROLE_SUSTAINABILITY_AND_ADAPTATION"] },
      "description": "Role-scoped dimensions derived by the compiler. NOT a universal set."
    },
    "dimension_weights": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 },
      "description": "Normalized weights (sum 1.0). Feed the analytics-only Overall Fit Index; never gate and never enter the Decision Authority."
    },
    "mandatory_gates": {
      "type": "array",
      "items": { "$ref": "mandatory_gate.schema.json" }
    },
    "evidence_requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "enum": ["RESUME", "PORTFOLIO", "INTERVIEW", "CODING_ASSESSMENT", "REFERENCE_CHECK", "BACKGROUND_CHECK", "CERTIFICATION", "EMPLOYMENT_HISTORY"] }
      },
      "description": "Per-dimension required evidence types that must be ADMITTED before scoring."
    },
    "confidence_thresholds": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "action_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["salary_ceiling", "approved_level"],
      "properties": {
        "salary_ceiling": { "type": "number", "minimum": 0 },
        "salary_currency": { "type": "string", "default": "USD" },
        "approved_level": { "type": "string" },
        "approved_roles": { "type": "array", "items": { "type": "string" } },
        "allowed_locations": { "type": "array", "items": { "type": "string" } }
      },
      "description": "Enforced by the Hiring ActionGate; deviation => DENY_REAUTH."
    },
    "runtime_assurance_checks": {
      "type": "array",
      "items": { "type": "string", "enum": ["APPROVALS_VALID", "REFERENCES_COMPLETE", "BACKGROUND_CHECK_CURRENT", "OFFER_NOT_EXPIRED", "SALARY_POLICY_SATISFIED", "REQUISITION_OPEN"] },
      "description": "Checks Runtime Assurance must pass immediately before the HRIS/ATS write."
    },
    "approval_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approver_role", "actor_type"],
        "properties": {
          "approver_role": { "type": "string" },
          "actor_type": { "const": "HUMAN" }
        }
      }
    },
    "review_schedule_months": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "default": [1, 3, 6, 12] },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pwc_version", "compiled_at", "rejection_checks"],
      "properties": {
        "pwc_version": { "type": "string" },
        "compiled_at": { "type": "string", "format": "date-time" },
        "rejection_checks": {
          "type": "object",
          "additionalProperties": false,
          "description": "All must be true for the IR to be emitted.",
          "properties": {
            "no_ofi_in_policy": { "type": "boolean" },
            "gates_non_compensatory": { "type": "boolean" },
            "weighted_dimensions_have_required_evidence": { "type": "boolean" },
            "approval_chain_human_only": { "type": "boolean" },
            "action_constraints_within_approver_authority": { "type": "boolean" },
            "constrained_actions_have_assurance_checks": { "type": "boolean" }
          }
        }
      }
    }
  }
}
