# Source distribution contents for ugence-ai-hiring.
include README.md
include CHANGELOG.md
include LICENSE
include pyproject.toml
recursive-include src/ugence_ai_hiring *.py
include src/ugence_ai_hiring/py.typed
recursive-include src/ai_hiring *.py
