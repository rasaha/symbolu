# Copy to .env and fill in. DO NOT COMMIT .env (it is gitignored).
# Generate the password hash offline:  python -m governance_studio_deployment.generate_password_hash
UGENCE_STUDIO_USERNAME=operator
UGENCE_STUDIO_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$REPLACE_ME$REPLACE_ME
UGENCE_STUDIO_ALLOWED_HOSTS=studio.example.internal
# Directory containing server.crt and server.key (mounted read-only). Never commit keys.
UGENCE_STUDIO_TLS_DIR=/absolute/path/to/tls
