{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ugence.ai/schemas/hiring/hiring_runtime_assurance.schema.json",
  "title": "HiringRuntimeAssuranceResult",
  "description": "Runs immediately BEFORE any HRIS/ATS write (ServiceNow, Workday, SAP, Oracle) to verify the world still satisfies the contract at write time. Any failed check blocks the write (hold + remediate) — never a silent write. Same pattern as the platform Runtime Assurance before a governed external write.",
  "type": "object",
  "additionalProperties": false,
  "required": ["assurance_id", "candidate_id", "action_gate_verdict_id", "contract_ref", "checks", "result"],
  "properties": {
    "assurance_id": { "type": "string" },
    "candidate_id": { "type": "string" },
    "action_gate_verdict_id": { "type": "string", "description": "Must reference a prior ALLOW ActionGate verdict." },
    "contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "version", "ir_digest"],
      "properties": {
        "contract_id": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "ir_digest": { "type": "string" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per runtime_assurance_check declared in the IR.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "status"],
        "properties": {
          "check": {
            "type": "string",
            "enum": ["APPROVALS_VALID", "REFERENCES_COMPLETE", "BACKGROUND_CHECK_CURRENT", "OFFER_NOT_EXPIRED", "SALARY_POLICY_SATISFIED", "REQUISITION_OPEN"]
          },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "INDETERMINATE"] },
          "detail": { "type": "string" },
          "evidence_ref": { "type": "string", "description": "Lineage node / system record substantiating the check." }
        }
      }
    },
    "result": {
      "type": "string",
      "enum": ["ASSURED", "BLOCKED"],
      "description": "ASSURED iff every check == PASS. Any FAIL or INDETERMINATE => BLOCKED (fail-closed)."
    },
    "target_system": { "type": "string", "enum": ["SERVICENOW", "WORKDAY", "SAP_SUCCESSFACTORS", "ORACLE_RECRUITING", "OTHER"] },
    "blocked_reason": { "type": "string" }
  }
}
