/*
 * Ontology Projection Kernel
 *
 * Projects 768-dim hidden states to 124-dim Cognitive State.
 * Implements the 12-layer ontological hierarchy with Kosha anchoring.
 *
 * Compile: coherac -arch pavpu10 -O3 -o ontology_projection.cbin ontology_projection.ckl
 */

#include <cohera_kernel.h>

// Cognitive State dimensions
#define PHONEME_DIM 44
#define TOPIC_DIM 64
#define ONTOLOGY_DIM 12
#define DYNAMICS_DIM 4
#define STATE_DIM 124  // 44 + 64 + 12 + 4

#define HIDDEN_DIM 768

// Layer frequencies (Hz) - hardcoded from ontology spec
__constant__ float LAYER_FREQUENCIES[12] = {
    10000.0f,  // O1_POTENTIAL
    5000.0f,   // O2_IDENTITY
    2000.0f,   // O3_EXECUTION
    1000.0f,   // O4_STRUCTURE
    500.0f,    // O5_COGNITION
    200.0f,    // O6_AGENCY
    100.0f,    // O7_REASONING
    40.0f,     // O8_PURPOSE
    20.0f,     // O9_WITNESSES
    10.0f,     // O10_UNIFYING
    5.0f,      // O11_INTEGRATION
    1.0f       // O12_ABSOLVING
};

// Kosha anchors for each layer
__constant__ int KOSHA_ANCHOR[12] = {
    0,  // O1 -> pre-annamaya
    1,  // O2 -> annamaya
    1,  // O3 -> annamaya
    2,  // O4 -> pranamaya
    3,  // O5 -> manomaya
    3,  // O6 -> manomaya
    4,  // O7 -> vijnanamaya
    4,  // O8 -> vijnanamaya
    5,  // O9 -> anandamaya
    5,  // O10 -> anandamaya
    5,  // O11 -> anandamaya
    5   // O12 -> bridge/none (mapped to anandamaya)
};


/*
 * Project hidden state to cognitive state
 *
 * Input:
 *   hidden[N, 768]  - Hidden states from transformer
 *   weights         - Projection weights (loaded from HBM)
 *
 * Output:
 *   state[N, 124]   - Cognitive state
 *   layer_acts[12]  - Per-layer activation (for monitoring)
 */
__phase_kernel__ void ontology_project(
    const float16* __restrict__ hidden,
    float16* __restrict__ state,
    float* __restrict__ layer_activations,
    const float16* __restrict__ w_phoneme,   // [768, 44]
    const float16* __restrict__ w_topic,     // [768, 64]
    const float16* __restrict__ w_ontology,  // [768, 12]
    const float16* __restrict__ w_dynamics,  // [768, 4]
    int seq_len
) {
    int gid = __block_idx() * __block_dim() + __thread_idx();
    if (gid >= seq_len) return;

    const float16* h = hidden + gid * HIDDEN_DIM;
    float16* out = state + gid * STATE_DIM;

    // =========================================================================
    // Phoneme Layer (44 dims) - Fast acoustic/visual patterns
    // =========================================================================
    for (int i = 0; i < PHONEME_DIM; i++) {
        float sum = 0.0f;
        for (int j = 0; j < HIDDEN_DIM; j++) {
            sum += (float)h[j] * (float)w_phoneme[j * PHONEME_DIM + i];
        }
        out[i] = (float16)sum;
    }

    // =========================================================================
    // Topic Layer (64 dims) - Semantic domain embedding
    // =========================================================================
    for (int i = 0; i < TOPIC_DIM; i++) {
        float sum = 0.0f;
        for (int j = 0; j < HIDDEN_DIM; j++) {
            sum += (float)h[j] * (float)w_topic[j * TOPIC_DIM + i];
        }
        out[PHONEME_DIM + i] = (float16)sum;
    }

    // =========================================================================
    // Ontology Layer (12 dims) - 12-layer activation probabilities
    // =========================================================================
    float ont_max = -1e10f;
    float ont_sum = 0.0f;
    float ont_raw[12];

    for (int i = 0; i < ONTOLOGY_DIM; i++) {
        float sum = 0.0f;
        for (int j = 0; j < HIDDEN_DIM; j++) {
            sum += (float)h[j] * (float)w_ontology[j * ONTOLOGY_DIM + i];
        }

        // Apply frequency modulation
        float freq_mod = __phase_mod_factor(LAYER_FREQUENCIES[i]);
        ont_raw[i] = sum * freq_mod;

        if (ont_raw[i] > ont_max) ont_max = ont_raw[i];
    }

    // Softmax over ontology layers
    for (int i = 0; i < ONTOLOGY_DIM; i++) {
        ont_raw[i] = expf(ont_raw[i] - ont_max);
        ont_sum += ont_raw[i];
    }

    for (int i = 0; i < ONTOLOGY_DIM; i++) {
        float prob = ont_raw[i] / ont_sum;
        out[PHONEME_DIM + TOPIC_DIM + i] = (float16)prob;

        // Store for monitoring
        if (gid == 0) {
            layer_activations[i] = prob;
        }
    }

    // =========================================================================
    // Dynamics Layer (4 dims) - Coherence, Entropy, Confidence, Momentum
    // =========================================================================
    for (int i = 0; i < DYNAMICS_DIM; i++) {
        float sum = 0.0f;
        for (int j = 0; j < HIDDEN_DIM; j++) {
            sum += (float)h[j] * (float)w_dynamics[j * DYNAMICS_DIM + i];
        }
        // Sigmoid to [0, 1]
        sum = 1.0f / (1.0f + expf(-sum));
        out[PHONEME_DIM + TOPIC_DIM + ONTOLOGY_DIM + i] = (float16)sum;
    }
}


/*
 * Compute state delta between consecutive states
 *
 * ΔS = S_{t+1} - S_t
 *
 * This is what the model learns - not token prediction, but meaning dynamics.
 */
__phase_kernel__ void state_delta(
    const float16* __restrict__ prev_state,  // [N, 124]
    const float16* __restrict__ curr_state,  // [N, 124]
    float16* __restrict__ delta,             // [N, 124]
    float* __restrict__ loss_mse,            // Scalar MSE loss
    int seq_len
) {
    int gid = __block_idx() * __block_dim() + __thread_idx();
    if (gid >= seq_len) return;

    __shared__ float loss_sum;
    if (__thread_idx() == 0) loss_sum = 0.0f;
    __syncthreads();

    float local_loss = 0.0f;

    for (int i = 0; i < STATE_DIM; i++) {
        int idx = gid * STATE_DIM + i;
        float d = (float)curr_state[idx] - (float)prev_state[idx];
        delta[idx] = (float16)d;
        local_loss += d * d;
    }

    atomicAdd(&loss_sum, local_loss);
    __syncthreads();

    if (gid == 0) {
        *loss_mse = loss_sum / (float)(seq_len * STATE_DIM);
    }
}


/*
 * Detect Vritti state from cognitive state
 *
 * Returns:
 *   0 = Pramana (valid cognition)
 *   1 = Viparyaya (misperception)
 *   2 = Vikalpa (imagination)
 *   3 = Smrti (memory)
 *   4 = Nidra (dormancy)
 */
__phase_kernel__ void detect_vritti(
    const float16* __restrict__ state,  // [124]
    int* __restrict__ vritti_out,
    float* __restrict__ confidence_out
) {
    // Extract dynamics from state
    float coherence = (float)state[120];
    float entropy = (float)state[121];
    float confidence = (float)state[122];

    // Check TCU for memory recall spike
    float tcu_activation = __tcu_get_activation_spike();

    // Vritti detection logic
    int vritti;
    float vritti_confidence;

    if (coherence > 0.8f && entropy < 0.3f) {
        // High coherence, low entropy = valid cognition
        vritti = 0;  // PRAMANA
        vritti_confidence = coherence * (1.0f - entropy);
    }
    else if (__phase_misalignment() > 0.5f) {
        // Significant phase misalignment = misperception
        vritti = 1;  // VIPARYAYA
        vritti_confidence = __phase_misalignment();
    }
    else if (entropy > 0.7f) {
        // High entropy = conceptual imagination
        vritti = 2;  // VIKALPA
        vritti_confidence = entropy;
    }
    else if (tcu_activation > 0.6f) {
        // TCU spike = memory recall
        vritti = 3;  // SMRTI
        vritti_confidence = tcu_activation;
    }
    else {
        // Low overall activation = dormancy
        vritti = 4;  // NIDRA
        vritti_confidence = 1.0f - coherence;
    }

    *vritti_out = vritti;
    *confidence_out = vritti_confidence;
}
