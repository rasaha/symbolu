/*
 * Phase Attention Kernel
 *
 * O(n) phase-coherent attention via Kuramoto synchronization.
 * Supports:
 *   - Causal masking (Mistral / hybrid decoder path)
 *   - Grouped Query Attention (num_kv_heads <= num_heads)
 *   - Sliding-window attention (window_size)
 *   - FP16 / BF16 / FP32 compute (dtype_id)
 *   - Runtime-parameterized sync steps & learning rate
 *
 * Compile: coherac -arch pavpu10 -O3 -o phase_attention.cbin phase_attention.ckl
 */

#include <cohera_kernel.h>

#define MAX_SEQ_LEN 32768
#define TWO_PI      6.28318530717958647692f

/* dtype_id mirrors cohera_dtype_t { FP16=0, BF16=1, FP32=2, INT8=3 } */
#define COHERA_DTYPE_FP16 0
#define COHERA_DTYPE_BF16 1
#define COHERA_DTYPE_FP32 2

static __inline__ float load_typed(const void* base, int idx, int dtype_id) {
    if (dtype_id == COHERA_DTYPE_FP32) return ((const float*)base)[idx];
    if (dtype_id == COHERA_DTYPE_BF16) return __bf16_to_f32(((const bfloat16*)base)[idx]);
    return (float)((const float16*)base)[idx];  /* FP16 fallback */
}

static __inline__ void store_typed(void* base, int idx, float v, int dtype_id) {
    if (dtype_id == COHERA_DTYPE_FP32)      ((float*)base)[idx]    = v;
    else if (dtype_id == COHERA_DTYPE_BF16) ((bfloat16*)base)[idx] = __f32_to_bf16(v);
    else                                    ((float16*)base)[idx]  = (float16)v;
}

/*
 * Single-head phase attention.
 *
 *  query[N, D_q]     (this head's query)
 *  key[N,  D_kv]     (KV head shared by `head_group_size` query heads)
 *  value[N, D_kv]
 *  output[N, D_q]
 *  coherence_out     scalar
 *
 *  causal:      1 = drop j > i
 *  window_size: -1 = full; else drop j < i - window_size + 1
 */
__phase_kernel__ void phase_attention_head(
    const void* __restrict__ query,
    const void* __restrict__ key,
    const void* __restrict__ value,
    void* __restrict__ output,
    float* __restrict__ coherence_out,
    int seq_len,
    int head_dim,
    int dtype_id,
    int causal,
    int window_size,
    int sync_steps,
    float sync_lr,
    int ontology_layer
) {
    int tid = __thread_idx();
    int bid = __block_idx();
    int gid = bid * __block_dim() + tid;

    __shared__ float phases[MAX_SEQ_LEN];
    __shared__ float sin_sum;
    __shared__ float cos_sum;

    if (gid >= seq_len) return;

    /* ----- 1. init phases from query projection ----- */
    float q_proj = 0.0f;
    for (int d = 0; d < head_dim; d++) {
        q_proj += load_typed(query, gid * head_dim + d, dtype_id);
    }
    phases[gid] = __phase_compute_scalar(q_proj);
    __syncthreads();

    /* ----- 2. Kuramoto sync (runtime params) ----- */
    for (int step = 0; step < sync_steps; step++) {
        if (tid == 0) { sin_sum = 0.0f; cos_sum = 0.0f; }
        __syncthreads();

        atomicAdd(&sin_sum, __sinf(phases[gid]));
        atomicAdd(&cos_sum, __cosf(phases[gid]));
        __syncthreads();

        float mean_phase = atan2f(sin_sum, cos_sum);
        float gradient   = -__sinf(phases[gid] - mean_phase);
        phases[gid]     += sync_lr * gradient;
        phases[gid]      = fmodf(phases[gid] + TWO_PI, TWO_PI);
        __syncthreads();
    }

    /* ----- 3. coherence over visible set ----- */
    if (tid == 0) { sin_sum = 0.0f; cos_sum = 0.0f; }
    __syncthreads();
    atomicAdd(&sin_sum, __sinf(phases[gid]));
    atomicAdd(&cos_sum, __cosf(phases[gid]));
    __syncthreads();

    float coherence  = sqrtf(sin_sum * sin_sum + cos_sum * cos_sum) / (float)seq_len;
    float mean_phase = atan2f(sin_sum, cos_sum);
    if (gid == 0) *coherence_out = coherence;

    /* ----- 4. masked weighted aggregation ----- */
    float threshold = __get_coherence_threshold(ontology_layer);

    int j_lo = 0;
    int j_hi = seq_len;
    if (causal)              j_hi = gid + 1;
    if (window_size > 0) {
        int lo = gid - window_size + 1;
        if (lo > j_lo) j_lo = lo;
    }

    if (coherence > threshold) {
        /* normalization count = visible tokens under the mask */
        float norm = (float)(j_hi - j_lo);
        if (norm < 1.0f) norm = 1.0f;

        for (int d = 0; d < head_dim; d++) {
            float v_sum = 0.0f;
            for (int j = j_lo; j < j_hi; j++) {
                float w_j = (1.0f + __cosf(phases[j] - mean_phase)) * 0.5f;
                v_sum   += w_j * load_typed(value, j * head_dim + d, dtype_id);
            }
            store_typed(output, gid * head_dim + d, v_sum / norm, dtype_id);
        }
    } else {
        /* below coherence: residual pass-through */
        for (int d = 0; d < head_dim; d++) {
            float q = load_typed(query, gid * head_dim + d, dtype_id);
            store_typed(output, gid * head_dim + d, q, dtype_id);
        }
    }

    /* ----- 5. TCU accumulate ----- */
    if (__tcu_enabled()) {
        __tcu_accumulate_phase(gid % __num_heads(), phases[gid]);
    }
}


/*
 * Multi-head phase attention with GQA.
 *
 *   query         [batch, seq, num_heads,    head_dim]
 *   key / value   [batch, seq, num_kv_heads, head_dim]
 *   output        [batch, seq, num_heads,    head_dim]
 *
 * Each query head h maps to KV head (h / head_group_size).
 * head_group_size = num_heads / num_kv_heads  (num_kv_heads==0 -> MHA).
 */
__phase_kernel__ void multi_head_phase_attention(
    const void* __restrict__ query,
    const void* __restrict__ key,
    const void* __restrict__ value,
    void* __restrict__ output,
    float* __restrict__ coherence,   /* [batch, num_heads] */
    int batch_size,
    int seq_len,
    int num_heads,
    int num_kv_heads,
    int head_dim,
    int dtype_id,
    int causal,
    int window_size,
    int sync_steps,
    float sync_lr,
    int ontology_layer
) {
    int batch_idx = __block_idx() / num_heads;
    int head_idx  = __block_idx() % num_heads;
    if (batch_idx >= batch_size) return;

    int kv_heads        = (num_kv_heads > 0) ? num_kv_heads : num_heads;
    int head_group_size = num_heads / kv_heads;
    int kv_head_idx     = head_idx / head_group_size;

    int q_stride_batch  = seq_len * num_heads  * head_dim;
    int kv_stride_batch = seq_len * kv_heads   * head_dim;

    int q_off  = batch_idx * q_stride_batch  + head_idx    * head_dim;
    int kv_off = batch_idx * kv_stride_batch + kv_head_idx * head_dim;

    int elem_size = (dtype_id == COHERA_DTYPE_FP32) ? 4 : 2;
    const void* q = (const char*)query  + q_off  * elem_size;
    const void* k = (const char*)key    + kv_off * elem_size;
    const void* v = (const char*)value  + kv_off * elem_size;
    void*       o = (char*)output       + q_off  * elem_size;
    float*      c = coherence + batch_idx * num_heads + head_idx;

    phase_attention_head(
        q, k, v, o, c,
        seq_len, head_dim, dtype_id,
        causal, window_size,
        sync_steps, sync_lr,
        ontology_layer
    );
}
