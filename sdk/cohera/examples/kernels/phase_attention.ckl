/*
 * Phase Attention Kernel
 *
 * Core kernel for O(n) phase-coherent attention using Kuramoto synchronization.
 *
 * Compile: coherac -arch pavpu10 -O3 -o phase_attention.cbin phase_attention.ckl
 */

#include <cohera_kernel.h>

// Configuration constants
#define MAX_SEQ_LEN 32768
#define HEAD_DIM 64
#define SYNC_STEPS 3
#define SYNC_LR 0.1f

/*
 * Single-head phase attention kernel
 *
 * Inputs:
 *   query[N, D]  - Query vectors
 *   key[N, D]    - Key vectors
 *   value[N, D]  - Value vectors
 *
 * Outputs:
 *   output[N, D] - Attended output
 *   coherence    - Scalar coherence score
 */
__phase_kernel__ void phase_attention_head(
    const float16* __restrict__ query,
    const float16* __restrict__ key,
    const float16* __restrict__ value,
    float16* __restrict__ output,
    float* __restrict__ coherence_out,
    int seq_len,
    int head_dim,
    int ontology_layer
) {
    // Thread indexing
    int tid = __thread_idx();
    int bid = __block_idx();
    int gid = bid * __block_dim() + tid;

    // Shared memory for phase synchronization
    __shared__ float phases[MAX_SEQ_LEN];
    __shared__ float sin_sum;
    __shared__ float cos_sum;

    if (gid >= seq_len) return;

    // =========================================================================
    // Step 1: Initialize phases from query vectors
    // =========================================================================
    // Project query to scalar, then map to [0, 2π]
    float q_proj = 0.0f;
    for (int d = 0; d < head_dim; d++) {
        q_proj += (float)query[gid * head_dim + d];
    }
    phases[gid] = __phase_compute_scalar(q_proj);  // sigmoid(x) * 2π

    __syncthreads();

    // =========================================================================
    // Step 2: Kuramoto phase synchronization
    // =========================================================================
    for (int step = 0; step < SYNC_STEPS; step++) {
        // Compute circular mean (reduction)
        if (tid == 0) {
            sin_sum = 0.0f;
            cos_sum = 0.0f;
        }
        __syncthreads();

        // Parallel reduction for mean phase
        float local_sin = __sinf(phases[gid]);
        float local_cos = __cosf(phases[gid]);

        atomicAdd(&sin_sum, local_sin);
        atomicAdd(&cos_sum, local_cos);
        __syncthreads();

        float mean_phase = atan2f(sin_sum, cos_sum);

        // Compute gradient and update phase
        float gradient = -__sinf(phases[gid] - mean_phase);
        phases[gid] += SYNC_LR * gradient;

        // Clamp to [0, 2π)
        phases[gid] = fmodf(phases[gid] + 6.28318f, 6.28318f);

        __syncthreads();
    }

    // =========================================================================
    // Step 3: Compute coherence
    // =========================================================================
    // Coherence = |Σ exp(iφ)| / N
    if (tid == 0) {
        sin_sum = 0.0f;
        cos_sum = 0.0f;
    }
    __syncthreads();

    atomicAdd(&sin_sum, __sinf(phases[gid]));
    atomicAdd(&cos_sum, __cosf(phases[gid]));
    __syncthreads();

    float coherence = sqrtf(sin_sum * sin_sum + cos_sum * cos_sum) / (float)seq_len;

    if (gid == 0) {
        *coherence_out = coherence;
    }

    // =========================================================================
    // Step 4: Compute attention weights from phases
    // =========================================================================
    // Weight = (1 + cos(φᵢ - φ_mean)) / 2  (normalized to [0, 1])
    float mean_phase = atan2f(sin_sum, cos_sum);
    float weight = (1.0f + __cosf(phases[gid] - mean_phase)) * 0.5f;

    // =========================================================================
    // Step 5: Apply coherence gating and weighted aggregation
    // =========================================================================
    float threshold = __get_coherence_threshold(ontology_layer);

    if (coherence > threshold) {
        // Output = weighted sum of values
        for (int d = 0; d < head_dim; d++) {
            float v_sum = 0.0f;
            for (int j = 0; j < seq_len; j++) {
                float w_j = (1.0f + __cosf(phases[j] - mean_phase)) * 0.5f;
                v_sum += w_j * (float)value[j * head_dim + d];
            }
            output[gid * head_dim + d] = (float16)(v_sum / (float)seq_len);
        }
    } else {
        // Below coherence threshold - pass through query (residual)
        for (int d = 0; d < head_dim; d++) {
            output[gid * head_dim + d] = query[gid * head_dim + d];
        }
    }

    // =========================================================================
    // Step 6: Update TCU for temporal context
    // =========================================================================
    if (__tcu_enabled()) {
        __tcu_accumulate_phase(gid % __num_heads(), phases[gid]);
    }
}


/*
 * Multi-head phase attention kernel
 * Launches phase_attention_head for each head in parallel
 */
__phase_kernel__ void multi_head_phase_attention(
    const float16* __restrict__ query,   // [batch, seq, heads, head_dim]
    const float16* __restrict__ key,
    const float16* __restrict__ value,
    float16* __restrict__ output,
    float* __restrict__ coherence,        // [batch, heads]
    int batch_size,
    int seq_len,
    int num_heads,
    int head_dim,
    int ontology_layer
) {
    int batch_idx = __block_idx() / num_heads;
    int head_idx = __block_idx() % num_heads;

    if (batch_idx >= batch_size) return;

    // Offset pointers for this batch and head
    int offset = batch_idx * seq_len * num_heads * head_dim + head_idx * head_dim;
    int stride = num_heads * head_dim;

    const float16* q = query + offset;
    const float16* k = key + offset;
    const float16* v = value + offset;
    float16* out = output + offset;
    float* coh = coherence + batch_idx * num_heads + head_idx;

    // Call single-head kernel
    phase_attention_head(q, k, v, out, coh, seq_len, head_dim, ontology_layer);
}
